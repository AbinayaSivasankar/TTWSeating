@code {
    [Parameter]
    public string ChartKey { get; set; } = "0";
    public string ChartId { get; set; }
    public bool ShowRowLabel { get; set; } = false;
    public bool ShowSeatLabel { get; set; } = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("chartPreviewRenderer.showLoader", "chartPreviewSvgHost");
                // 1. Fetch layout JSON first & populate ChartId
                string json = GetSeatingLayout();

                if (!string.IsNullOrEmpty(json) && !string.IsNullOrEmpty(ChartId) && ChartId != "0")
                {
                    // 2. Fetch seats data using valid ChartId
                    DataSet seatsDs = getSeats();
                    var seatList = new List<object>();
                    if (seatsDs != null && seatsDs.Tables.Count > 0)
                    {
                        foreach (DataRow row in seatsDs.Tables[0].Rows)
                        {
                            seatList.Add(new
                            {
                                chart_id = row["chart_id"] ?? 0,
                                seat_name = row["seat_name"]?.ToString(),
                                row_name = row["row_name"]?.ToString(),
                                cat_name = row["cat_name"]?.ToString(),
                                status = row["status"]?.ToString(),
                                hold_token = row["hold_token"]?.ToString()
                            });
                        }
                    }
                    string seatsJson = JsonConvert.SerializeObject(seatList);

                    // 3. Invoke JS to render
                    await JS.InvokeVoidAsync("chartPreviewRenderer.render", "chartPreviewSvgHost", json, seatsJson);
                }
                else
                {
                    Console.WriteLine($"No chart layout found for ChartKey: {ChartKey}");
                    await JS.InvokeVoidAsync("chartPreviewRenderer.hideLoader", "chartPreviewSvgHost");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading user chart: {ex.Message}");
                try { await JS.InvokeVoidAsync("chartPreviewRenderer.hideLoader", "chartPreviewSvgHost"); } catch { }
            }
        }
    }
    private async Task LoadLayout()
    {
        string json = GetSeatingLayout();

        if (!string.IsNullOrWhiteSpace(json))
        {
            await JS.InvokeVoidAsync("chartPreviewRenderer.render", "chartPreviewSvgHost", json, "[]");
        }
        // SVG preview does not use the Fabric.js canvas.
    }
   public string GetSeatingLayout()
    {
        cdlChart objChart = new cdlChart();
        NameValueCollection vncParams = new NameValueCollection();
        DataSet ds = new DataSet();
        vncParams.Add("chart_id", "0");
        vncParams.Add("log_id", "0");
        vncParams.Add("chart_key", ChartKey);
        vncParams.Add("option", "C");
        objChart.GetChartCategory(vncParams, ref ds);

        if (ds != null && ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
        {
            DataRow dr = ds.Tables[0].Rows[0];
            ChartId = dr["chart_id"].ToString();
            return dr["chart_json"]?.ToString() ?? "";
        }
        return "";
    }

    public async void BookClick()
    {
        try
        {
            // Get the selected seats from JavaScript
            var selectedSeats = await JS.InvokeAsync<List<SelectedSeat>>(
                "fabricInterop.getSelectedSeatsForBooking",
                "userCanvas" // Replace with your actual canvas ID
            );

            if (selectedSeats == null || selectedSeats.Count == 0)
            {
                // Show message if no seats selected
                await JS.InvokeVoidAsync("alert", "Please select seats first!");
                return;
            }

            // Process the booking - save to database, update status, etc.
            foreach (var seat in selectedSeats)
            {
                // Here you would save to your database
                // Example:
                // await SaveBookingToDatabase(seat.Id, seat.Label, seat.CategoryId, etc.);
                await JS.InvokeVoidAsync("fabricInterop.toggleSeatStatus", "userCanvas", seat);

                Console.WriteLine($"Booking seat: {seat.Id}, Label: {seat.Label}");
            }

            // Clear the selected seats after booking
            await JS.InvokeVoidAsync("fabricInterop.clearSelectedSeats", "userCanvas");

            // Show success message
            await JS.InvokeVoidAsync("alert", $"Successfully booked {selectedSeats.Count} seat(s)!");

            // Optionally, update the UI or refresh data
            // StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error booking seats: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Error booking seats: " + ex.Message);
        }
    }
    public DataSet getSeats()
    {
        if (string.IsNullOrEmpty(ChartId) || ChartId == "0") return null;

        cdlSeat objSeat = new cdlSeat();
        NameValueCollection vncParams = new NameValueCollection();
        DataSet ds = new DataSet();
        vncParams.Add("chart_id", ChartId);
        vncParams.Add("seat_name", "0");
        vncParams.Add("row_name", "0");
        vncParams.Add("cat_name", "");
        vncParams.Add("option", "C");
        objSeat.Getseats(vncParams, ref ds);
        return ds;
    }
    private async Task ToggleRowLabel()
    {
        await JS.InvokeVoidAsync("chartPreviewRenderer.toggleRowLabels");
    }

    private async Task ToggleSeatLabel()
    {
        await JS.InvokeVoidAsync("chartPreviewRenderer.toggleSeatLabels");
    }
    public class SelectedSeat
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string CategoryId { get; set; } = "";
        public string SeatType { get; set; } = "";
        public double X { get; set; }
        public double Y { get; set; }
    }
}
