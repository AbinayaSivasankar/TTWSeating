@page "/counter/{ChartKey}"
@using DataLayer;
@using System.Collections.Specialized
@using System.Data
@using Newtonsoft.Json
@inject IJSRuntime JS
@layout SeatingLayout
<div style="position: absolute; top: 20px; right: 20px; z-index: 100; background: white; padding: 8px 12px; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
    <label style="margin-right: 16px;">
        <input id="chkrow" type="checkbox" checked @onchange="ToggleRowLabel"/> Show Row Label
    </label>
    <label>
        <input id="chkseat" type="checkbox" checked @onchange="ToggleSeatLabel"/> Show Seat Label
    </label>
</div>
<div id="chart-container" style="width: 100%; min-height: 800px; position: relative;">
    <div id="chartPreviewSvgHost" style="width:100%; min-height:800px;"></div>
</div>
   
