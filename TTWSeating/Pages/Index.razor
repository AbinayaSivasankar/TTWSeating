@* The editor script lives in wwwroot/Script/chart-editor.js and is imported as an ES module in OnAfterRenderAsync. *@

@code {
    [Parameter]
    public string ChartID { get; set; } = "0";

    private IJSObjectReference module;
    private string UserId = "0";
    private string UserEmail = "";
    private string ChartTitle = "Untitled chart";
    private string ChartJson = "";
    private bool _rendered;
    private bool _busy;
    public static string ChartKey { get; set; } = "";
    public static string EventKey { get; set; } = "";

    // The editor DOM is owned by chart-editor.js, so Blazor must not diff it again after the first render.
    protected override bool ShouldRender() => !_rendered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _rendered = true;

        var email = await Session.GetAsync<string>("UserEmail");
        var uid = await Session.GetAsync<string>("UserId");
        UserEmail = email.Success ? email.Value : "";
        UserId = uid.Success ? uid.Value : "0";
        if (string.IsNullOrEmpty(UserId) || UserId == "0")
        {
            NavManager.NavigateTo("/");
            return;
        }

        if (!LoadChart())
        {
            NavManager.NavigateTo("home");
            return;
        }

        module = await JS.InvokeAsync<IJSObjectReference>("import", "./Script/chart-editor.js");
        await module.InvokeVoidAsync("init", new
        {
            title = ChartTitle,
            chartJson = ChartJson,
            email = UserEmail,
            initial = string.IsNullOrEmpty(UserEmail) ? "?" : UserEmail.Substring(0, 1),
            demo = false          // true = start a new chart with the sample stage / rows / table
        });
    }

    // chart_id 0 = new chart. Existing charts must belong to the logged in user.
    private bool LoadChart()
    {
        if (ChartID == "0") return true;
        if (!int.TryParse(ChartID, out int id) || id <= 0) return false;

        cdlChart objchart = new cdlChart();
        DataSet ds = new DataSet();
        NameValueCollection vncParams = new NameValueCollection();
        vncParams.Add("chart_id", id.ToString());
        vncParams.Add("log_id", "0");
        vncParams.Add("chart_key", "");
        vncParams.Add("option", "");
        objchart.GetChartCategory(vncParams, ref ds);
        if (ds == null || ds.Tables.Count == 0 || ds.Tables[0].Rows.Count == 0) return false;

        DataRow dr = ds.Tables[0].Rows[0];
        if (dr["created_by"] != DBNull.Value && dr["created_by"].ToString() != UserId) return false;

        ChartTitle = dr["chart_title"].ToString();
        ChartJson = dr["chart_json"].ToString();
        ChartKey = dr["chart_key"].ToString();
        EventKey = dr["event_key"].ToString();
        return true;
    }

    private async Task SaveChart()
    {
        if (module == null || _busy) return;
        if (!await module.InvokeAsync<bool>("validate")) return;   // chart name is required
        _busy = true;
        try
        {
            ChartPayload d = await module.InvokeAsync<ChartPayload>("getData");
            int id = Persist(d, ChartID, d.Title);
            await module.InvokeVoidAsync("markSaved");
            await Session.SetAsync("FlashMessage", $"Layout saved ({d.SeatCount} seats)");
            NavManager.NavigateTo("home");
           
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Save chart failed: {ex}");
            await module.InvokeVoidAsync("toast", "Save failed - " + ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyChart()
    {
        if (module == null || _busy) return;
        if (!await module.InvokeAsync<bool>("validate")) return;   // chart name is required
        _busy = true;
        try
        {
            ChartPayload d = await module.InvokeAsync<ChartPayload>("getData");
            int id = Persist(d, "0", d.Title + " (copy)");
            await Session.SetAsync("FlashMessage", "Chart copied");
            NavManager.NavigateTo("home");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Copy chart failed: {ex}");
            await module.InvokeVoidAsync("toast", "Copy failed - " + ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelChart()
    {
        if (module != null && !await module.InvokeAsync<bool>("canLeave")) return;
        NavManager.NavigateTo("home");
    }

    private async Task Logout()
    {
        if (module != null && !await module.InvokeAsync<bool>("canLeave")) return;
        await Session.DeleteAsync("UserEmail");
        await Session.DeleteAsync("UserId");
        NavManager.NavigateTo("/");
    }

    private int Persist(ChartPayload d, string chartId, string title)
    {
        if (title.Length > 100) title = title.Substring(0, 100);   // eventchart.chart_title is varchar(100)
        NameValueCollection p = new NameValueCollection();
        p.Add("chart_id", chartId);
        p.Add("chart_title", title);
        p.Add("chart_json", d.ChartJson);
        p.Add("cat_name", d.CatName);
        p.Add("seats_json", d.SeatsJson);
        p.Add("chart_key", ChartKey);
        p.Add("event_key", EventKey);
        p.Add("log_id", UserId);
        return new cdlChart().SaveChart(p);
    }

    public async ValueTask DisposeAsync()
    {
        if (module == null) return;
        try
        {
            await module.InvokeVoidAsync("dispose");
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }

    public class ChartPayload
    {
        public string Title { get; set; } = "";
        public string ChartJson { get; set; } = "";
        public string CatName { get; set; } = "";
        public string SeatsJson { get; set; } = "[]";
        public int SeatCount { get; set; }
    }
}
