    [JSInvokable]
    public async Task SaveCategory(string cat)
    {
        if (ChartId != "0")
        {
            cdlChart objChart = new cdlChart();
            NameValueCollection vncParams = new NameValueCollection();
            vncParams.Add("chart_id", ChartId);
            vncParams.Add("cat_name", cat);
            objChart.UpdateCategory(vncParams);
        }
        else
        {
            var test = JsonConvert.DeserializeObject<List<CategoryModel>>(cat);
            await sessionStorage.SetAsync("categories", test);
            var result = await sessionStorage.GetAsync<List<CategoryModel>>("categories");
            if (result.Success)
                CategoryList = result.Value;
            ChartCat = cat;
        }
        Instance?.InvokeAsync(() => Instance.StateHasChanged());
    }

    public void GetChartCategory()
    {
        cdlChart objChart = new cdlChart();
        NameValueCollection vncParams = new NameValueCollection();
        DataSet ds = new DataSet();
        vncParams.Add("chart_id", ChartID);
        vncParams.Add("log_id", "0");
        vncParams.Add("chart_key", "");
        vncParams.Add("option", "");
        objChart.GetChartCategory(vncParams, ref ds);
        if (ds != null && ds.Tables[0].Rows.Count > 0)
        {
            DataRow dr = ds.Tables[0].Rows[0];
            ChartId = dr["chart_id"].ToString();
            ChartTitle = dr["chart_title"].ToString();
            ChartKey = dr["chart_key"].ToString();
            EventKey = dr["event_key"].ToString();
            ChartCat = dr["cat_name"].ToString();
            CategoryList = JsonConvert.DeserializeObject<dynamic>(dr["cat_name"].ToString());
        }
    }

    public async void EditCat()
    {
        await JS.InvokeVoidAsync("editCategoryName");
    }

    [JSInvokable]
    public static Task SaveSeatingLayout(string json, string type,string name)
    {
        Type = type;
        NewChartName = name;
        File.WriteAllText("layout.json", json);
        var data = JsonConvert.DeserializeObject<CanvasLayout>(json);
        SaveLayoutToDatabase(data);
        return Task.CompletedTask;
    }

    public class CanvasLayout
    {
        public string version { get; set; }
        public CanvasObject[] objects { get; set; }
    }

    public class CanvasObject
    {
        public string type { get; set; }
        public double left { get; set; }
        public double top { get; set; }
        public double width { get; set; }
        public double height { get; set; }
        public string fill { get; set; }
        public string stroke { get; set; }
        public string id { get; set; }
        public string seatLabel { get; set; }
        public string categoryId { get; set; }
        public string seatType { get; set; }
        public string seatId { get; set; }
        public string rowLabel { get; set; }
        public Boolean isRowLabel { get; set; }
        public string seatStatus { get; set; }
        public string rectangleId { get; set; }
        public string rectangleLabel { get; set; }
        public string rectangleIcon { get; set; }
        public string createdBy { get; set; }
        public string objectType { get; set; }
        public string holdToken { get; set; }
        public string categoryName { get; set; }
        public int capacity { get; set; }
        public string generalLabel { get; set; }
        public string seatLabelFormat { get; set; }
        public string customLabelStart { get; set; }
        public string rowLabelFormat { get; set; }
        public string rowLabelCustomStart { get; set; }
    }

    public async static void SaveLayoutToDatabase(CanvasLayout layout)
    {
        try
        {
            if(Type == "Copy")
            {
                ChartId = "0";
            }
            string json = JsonConvert.SerializeObject(layout);
            SaveChartJson(json);
            if (ChartId == "0")
                SaveSeats(json);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    public static void SaveChartJson(string chartlayout)
    {
        cdlChart objChart = new cdlChart();
        NameValueCollection vncParams = new NameValueCollection();
        DataSet ds = new DataSet();
        vncParams.Add("chart_id", ChartId);
        if (Type == "New")
        {
            vncParams.Add("chart_title", ChartTitle);
        }
        else
        {
            vncParams.Add("chart_title", NewChartName);
        }
        if (ChartId == "0")
        {
            ChartKey = Guid.NewGuid().ToString();
            EventKey = Guid.NewGuid().ToString();
            vncParams.Add("chart_key", ChartKey);
            vncParams.Add("event_key", EventKey);
        }
        else
        {
            vncParams.Add("chart_key", ChartKey);
            vncParams.Add("event_key", EventKey);
        }
        vncParams.Add("chart_json", chartlayout);
        vncParams.Add("cat_name", ChartCat);
        vncParams.Add("rec_stat", "A");

        Int64 chartid = 0;
        if (ChartId == "0")
        {
            objChart.Add(vncParams, ref chartid, Convert.ToInt32(UserId));
            SavedChart = chartid.ToString();
        }
        else
        {
            objChart.Change(vncParams, ref chartid, Convert.ToInt32(UserId));
            SavedChart = chartid.ToString();
        }
    }

    public async static void SaveSeats(string chartlayout)
    {
        try
        {
            var items = JsonConvert.DeserializeObject<CanvasLayout>(chartlayout);
            var seats = items.objects
                .Where(o => o.type == "group" && !string.IsNullOrEmpty(o.seatId))
                .ToList();

            cdlSeat objSeat = new cdlSeat();
            foreach (var seat in seats)
            {
                NameValueCollection vncParams = new NameValueCollection();
                vncParams.Add("chart_id", SavedChart);
                vncParams.Add("row_name", seat.rowLabel);
                vncParams.Add("seat_name", seat.seatId);
                vncParams.Add("cat_name", seat.categoryName);
                vncParams.Add("status", seat.seatStatus);
                vncParams.Add("hold_token", "");
                objSeat.Add(vncParams);
            }


            var gaAreas = items.objects
           .Where(o => o.objectType == "genrectangle" && !string.IsNullOrEmpty(o.rectangleId))
           .ToList();
            if (gaAreas.Count > 0){
                foreach (var gaArea in gaAreas)
                {
                    int capacity = gaArea.capacity > 0 ? gaArea.capacity : 0;
                    string categoryName = gaArea.categoryName ?? "General";
                    string rectangleId = gaArea.rectangleId ?? Guid.NewGuid().ToString();

                    // Create individual seat records for GA area based on capacity
                    for (int i = 1; i <= capacity; i++)
                    {
                        NameValueCollection vncParams = new NameValueCollection();
                        vncParams.Add("chart_id", SavedChart);
                        vncParams.Add("row_name", $"GA-{gaArea.generalLabel ?? "Area"}");
                        vncParams.Add("seat_name", $"{gaArea.generalLabel ?? "GA"}-{i:000}");
                        vncParams.Add("cat_name", categoryName);
                        vncParams.Add("status", "available");
                        vncParams.Add("hold_token", "");
                        // vncParams.Add("seat_type", "ga");
                        // vncParams.Add("rectangle_id", rectangleId);
                        // vncParams.Add("seat_number", i.ToString());
                        objSeat.Add(vncParams);
                    }
                }
            }
        }
       
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task LoadLayout()
    {
        string json = GetSeatingLayout();
        if (!string.IsNullOrWhiteSpace(json))
            await JS.InvokeVoidAsync("fabricInterop.loadLayout", "seatCanvas", json);
    }

    public string GetSeatingLayout()
    {
        cdlChart objChart = new cdlChart();
        NameValueCollection vncParams = new NameValueCollection();
        DataSet ds = new DataSet();
        vncParams.Add("chart_id", ChartID);
        vncParams.Add("log_id", "0");
        vncParams.Add("chart_key", "");
        vncParams.Add("option", "");
        objChart.GetChartCategory(vncParams, ref ds);
        if (ds != null && ds.Tables[0].Rows.Count > 0)
        {
            DataRow dr = ds.Tables[0].Rows[0];
            return dr["chart_json"].ToString();
        }
        return "";
    }

    void Undo() => JS.InvokeVoidAsync("undo");
    void Redo() => JS.InvokeVoidAsync("redo");
    void ZoomOutClick() => JS.InvokeVoidAsync("zoomOut");
    void ResetView() => JS.InvokeVoidAsync("resetZoom");

    public async Task ddlseat_Click(ChangeEventArgs e)
    {
        if (e.Value.ToString() != "0")
        {
            SeatLabel = e.Value.ToString();
            ShowCustomInput = e.Value.ToString() == "custom";
        }
    }

    public async Task ddlrow_Click(ChangeEventArgs e)
    {
        if (e.Value.ToString() != "0")
        {
            RowLabel = e.Value.ToString();
            ShowCustomRow = e.Value.ToString() == "custom";
        }
    }

    private void ToggleDropdown()
    {
        dropdownVisible = !dropdownVisible;
    }

    [JSInvokable]
    public void CloseDropdown()
    {
        if (dropdownVisible)
        {
            dropdownVisible = false;
            StateHasChanged();
        }
    }

    private async Task Logout()
    {
        dropdownVisible = false;
        await sessionStorage.SetAsync("UserId", "0");
        // NavManager.NavigateTo("/");
        NavManager.NavigateTo(NavManager.BaseUri, true);
    }


    public class CategoryModel
    {
        public string category { get; set; }
        public string color { get; set; }
    }
}