                    <input type="text" id="txtcapacity" class="terracotta-cap-input" @bind="@SeatingCapacity" />
                    <button class="terracotta-cap-btn" onclick="IncrementClick()"><i class="fa-solid fa-plus"></i></button>
                </div>
            </div>

        </aside>
    </div>
</div>

