@page "/index/{ChartID}"
@implements IAsyncDisposable
@using System.Collections.Specialized
@using System.Data
@using DataLayer
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.JSInterop
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject ProtectedSessionStorage Session

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    :root {
        --bg: #f3f5fa;
        --pan: #fff;
        --soft: #f7f8fc;
        --line: #e4e8f2;
        --tx: #1e2540;
        --mu: #6b7694;
        --ac: #4f46e5;
        --acs: #eef0ff;
        --dg: #e5484d;
        --sh: 0 1px 2px #1e254012,0 4px 14px #1e25400d
    }


    * {
        box-sizing: border-box;
        margin: 0
    }

    .editor-root {
        position: fixed;
        inset: 0;
        z-index: 1000;
        font: 13.5px/1.4 "Segoe UI",Inter,system-ui,sans-serif;
        background: var(--bg);
        color: var(--tx);
        display: flex;
        flex-direction: column;
        overflow: hidden
    }

    html, body {
        overflow: hidden
    }

    button {
        font: inherit;
        color: inherit;
        background: none;
        border: 0;
        cursor: pointer
    }

    input, select {
        font: inherit;
        color: var(--tx);
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 7px 10px;
        width: 100%
    }

        input:focus, select:focus {
            outline: 0;
            border-color: var(--ac);
            box-shadow: 0 0 0 3px #4f46e522
        }

        input[type=range] {
            padding: 0;
            accent-color: var(--ac);
            border: 0;
            box-shadow: none
        }

        input[type=color] {
            padding: 0;
            width: 24px;
            height: 24px;
            border: 0;
            border-radius: 50%;
            background: none;
            cursor: pointer
        }

    h5 {
        font-size: 11px;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--mu);
        font-weight: 700
    }

    .top {
        height: 56px;
        background: var(--pan);
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 16px;
        flex: none
    }

    .logo {
        font-weight: 800;
        font-size: 18px;
        display: flex;
        gap: 9px;
        align-items: center;
        letter-spacing: -.02em
    }

        .logo i {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            background: var(--ac);
            display: grid;
            place-items: center;
            font-size: 14px;
            color: #fff;
            box-shadow: 0 4px 10px #4f46e540
        }

    .crumb {
        color: #b4bbd0;
        font-size: 18px
    }

    .ttl {
        width: 260px;
        font-weight: 600;
        font-size: 14.5px;
        border-color: transparent;
        background: transparent
    }

        .ttl:hover {
            background: var(--soft)
        }

        .ttl:focus {
            background: #fff
        }

    .sp {
        flex: 1
    }

    .bt {
        padding: 0px 20px;
        height: 44px;
        border-radius: 24px;
        font-weight: 600;
        border: 1px solid var(--line);
        background: #fff;
        box-shadow: var(--sh)
    }

        .bt:hover {
            background: var(--soft)
        }

        .bt.pr {
            background: var(--ac);
            border-color: var(--ac);
            color: #fff;
            box-shadow: inset 0 0 1px #9590ff, inset 0 -2px 0 #0003, 0 1px 2px #0006, 0 8px 24px -6px #5b5bf099 !important;
        }

            .bt.pr:hover {
                filter: brightness(1.1)
            }

    .av {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--acs);
        color: var(--ac);
        display: grid;
        place-items: center;
        font-weight: 700;
        position: relative;
        cursor: pointer;
        border: 1px solid #d9dcff
    }

    .mn {
        display: none;
        position: absolute;
        right: 0;
        top: 42px;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 12px;
        min-width: 200px;
        padding: 6px;
        z-index: 60;
        box-shadow: 0 12px 32px #1e254026;
        font-weight: 400;
        color: var(--tx)
    }

        .mn.show {
            display: block
        }

        .mn div {
            padding: 8px 10px;
            color: var(--mu);
            font-size: 12px;
            border-bottom: 1px solid var(--line);
            margin-bottom: 4px
        }

        .mn button {
            width: 100%;
            text-align: left;
            padding: 8px 10px;
            border-radius: 8px
        }

            .mn button:hover {
                background: var(--soft)
            }

    .bar {
        background: var(--pan);
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: stretch;
        gap: 4px;
        padding: 6px 16px;
        flex: none
    }

    .grp {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0 8px
    }

        .grp .gi {
            display: flex;
            gap: 2px
        }

        .grp .cap {
            font-size: 10px;
            color: #9aa3bd;
            margin-top: 3px;
            letter-spacing: .04em
        }

    .gs {
        width: 1px;
        background: var(--line);
        margin: 2px 6px
    }

    .tl {
        width: 58px;
        padding: 6px 0 5px;
        border-radius: 10px;
        color: #56617f;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
        font-size: 11px;
        font-weight: 500
    }

        .tl i {
            font-size: 16px
        }

        .tl:hover {
            background: var(--soft);
            color: var(--tx)
        }

        .tl.on {
            background: var(--acs);
            color: var(--ac);
            box-shadow: inset 0 0 0 1.5px #c9ceff;
            font-weight: 600
        }

    .ib {
        width: 36px;
        height: 42px;
        border-radius: 10px;
        color: #56617f;
        display: grid;
        place-items: center;
        font-size: 15px
    }

        .ib:hover {
            background: var(--soft);
            color: var(--tx)
        }

        .ib:disabled {
            opacity: .3;
            pointer-events: none
        }

        .ib.on {
            background: var(--acs);
            color: var(--ac)
        }

    .main {
        flex: 1;
        display: flex;
        min-height: 0;
        gap: 12px;
        padding: 12px
    }

    .left, .right {
        background: var(--pan);
        border: 1px solid var(--line);
        border-radius: 14px;
        box-shadow: var(--sh);
        display: flex;
        flex-direction: column;
        flex: none;
        overflow: hidden
    }

    .left {
        width: 250px
    }

    .right {
        width: 300px;
        overflow: auto
    }

    .blk {
        border-bottom: 1px solid var(--line);
        padding-bottom: 10px
    }

        .blk.grow {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
            border: 0;
            padding-bottom: 0
        }

    .bh {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 13px 14px 9px
    }

    .badge {
        background: var(--soft);
        border: 1px solid var(--line);
        border-radius: 20px;
        padding: 0 8px;
        font-size: 11px;
        color: var(--mu)
    }

    .add {
        color: var(--ac);
        font-weight: 600;
        font-size: 12.5px;
        padding: 3px 8px;
        border-radius: 7px
    }

        .add:hover {
            background: var(--acs)
        }

    .ct {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 8px;
        margin: 0 10px 5px;
        border: 1px solid var(--line);
        border-radius: 10px;
        cursor: pointer;
        background: #fff
    }

        .ct:hover {
            background: var(--soft)
        }

        .ct.a {
            border-color: var(--ac);
            background: var(--acs)
        }

        .ct input[type=text] {
            border: 0;
            background: none;
            padding: 2px;
            flex: 1;
            min-width: 0;
            box-shadow: none;
            font-weight: 500
        }

        .ct .n {
            font-size: 11px;
            color: var(--mu);
            background: #fff;
            border-radius: 10px;
            padding: 0 7px;
            border: 1px solid var(--line)
        }

        .ct button {
            color: #aab2c9
        }

            .ct button:hover {
                color: var(--dg)
            }

    .objs {
        flex: 1;
        overflow: auto;
        padding: 0 8px 10px
    }

    .ob {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 7px 9px;
        border-radius: 9px;
        cursor: pointer;
        font-size: 12.5px
    }

        .ob:hover {
            background: var(--soft)
        }

        .ob.sel {
            background: var(--acs);
            color: var(--ac)
        }

        .ob i {
            width: 16px;
            text-align: center;
            color: #8f99b5
        }

        .ob.sel i {
            color: var(--ac)
        }

        .ob .d {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            margin-left: auto;
            flex: none
        }

        .ob small {
            color: var(--mu)
        }

    .cv {
        flex: 1;
        position: relative;
        min-width: 0;
        border: 1px solid var(--line);
        border-radius: 14px;
        box-shadow: var(--sh);
        overflow: hidden;
        background: #fcfdff;
        background-image: radial-gradient(#cdd4e6 1.2px,transparent 1.2px);
        background-size: 20px 20px
    }

        .cv.nogrid {
            background-image: none
        }

    svg#st {
        width: 100%;
        height: 100%;
        display: block;
        touch-action: none
    }

    .hint {
        position: absolute;
        top: 12px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 12px;
        color: var(--mu);
        background: #fffd;
        border: 1px solid var(--line);
        padding: 5px 14px;
        border-radius: 20px;
        pointer-events: none;
        white-space: nowrap;
        box-shadow: var(--sh)
    }

    .zm {
        position: absolute;
        right: 12px;
        bottom: 12px;
        display: flex;
        align-items: center;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 10px;
        box-shadow: var(--sh)
    }

        .zm button {
            width: 34px;
            height: 34px;
            color: var(--mu)
        }

            .zm button:hover {
                color: var(--ac)
            }

        .zm span {
            min-width: 48px;
            text-align: center;
            font-size: 12px;
            color: var(--mu)
        }

    .in {
        padding: 0 14px 14px
    }

    .f {
        margin-bottom: 10px
    }

        .f label {
            display: block;
            font-size: 11.5px;
            color: var(--mu);
            margin-bottom: 4px;
            font-weight: 500
        }

    .g2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px
    }

    .stp {
        display: flex
    }

        .stp button {
            width: 36px;
            background: var(--soft);
            border: 1px solid var(--line)
        }

        .stp input {
            border-radius: 0;
            text-align: center
        }

        .stp button:first-child {
            border-radius: 8px 0 0 8px;
            border-right: 0
        }

        .stp button:last-child {
            border-radius: 0 8px 8px 0;
            border-left: 0
        }

    .ap {
        width: 100%;
        padding: 10px;
        border-radius: 10px;
        background: var(--ac);
        font-weight: 600;
        color: #fff;
        box-shadow: 0 4px 12px #4f46e533
    }

        .ap:hover {
            filter: brightness(1.1)
        }

    .row2 {
        display: flex;
        gap: 6px;
        margin-top: 8px
    }

        .row2 button {
            flex: 1;
            padding: 8px;
            border-radius: 9px;
            background: var(--soft);
            border: 1px solid var(--line);
            font-size: 12.5px
        }

            .row2 button:hover {
                background: #fff;
                border-color: #c9d0e4
            }

        .row2 .dg:hover {
            border-color: var(--dg);
            color: var(--dg)
        }

    .er {
        display: none;
        margin: 8px 10px 0;
        padding: 8px 11px;
        border-radius: 9px;
        background: #fff0f0;
        color: #c0343a;
        font-size: 12px;
        border: 1px solid #ffd6d8
    }

    .em {
        text-align: center;
        color: var(--mu);
        padding: 30px 12px;
        background: var(--soft);
        border: 1px dashed var(--line);
        border-radius: 12px
    }

        .em i {
            display: block;
            font-size: 26px;
            margin-bottom: 8px;
            color: #b4bbd0
        }

    .bot {
        height: 42px;
        background: var(--pan);
        border-top: 1px solid var(--line);
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 0 18px;
        flex: none;
        font-size: 12px;
        color: var(--mu);
        overflow: auto;
        white-space: nowrap
    }

        .bot b {
            color: var(--tx)
        }

    .chip {
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        padding: 4px 10px;
        border-radius: 20px;
        border: 1px solid var(--line);
        background: #fff
    }

        .chip:hover {
            background: var(--acs);
            border-color: #c9ceff
        }

        .chip i {
            width: 9px;
            height: 9px;
            border-radius: 50%
        }

    .toast {
        position: fixed;
        left: 50%;
        bottom: 60px;
        transform: translate(-50%,16px);
        background: var(--tx);
        color: #fff;
        padding: 10px 18px;
        border-radius: 12px;
        opacity: 0;
        transition: .2s;
        pointer-events: none;
        font-weight: 600;
        box-shadow: 0 10px 30px #1e254040
    }

        .toast.show {
            opacity: 1;
            transform: translate(-50%,0)
        }

    i svg {
        width: 1em;
        height: 1em;
        vertical-align: -.14em;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        display: inline-block
    }

    i {
        font-style: normal
    }

    .pop {
        transform-box: fill-box;
        transform-origin: center;
        animation: pop .3s cubic-bezier(.3,1.7,.5,1) both
    }

    @@keyframes pop {
        from {
            transform: scale(0);
            opacity: 0
        }

        to {
            transform: scale(1);
            opacity: 1
        }
    }

    .pulse {
        transform-box: fill-box;
        transform-origin: center;
        animation: pulse 1s ease-in-out infinite
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
            opacity: 1
        }

        50% {
            transform: scale(1.35);
            opacity: .45
        }
    }

    .joy {
        position: absolute;
        right: 30px;
        bottom: 60px;
        width: 86px;
        height: 86px;
        border-radius: 50%;
        background: #fff;
        border: 1px solid var(--line);
        box-shadow: var(--sh);
        touch-action: none;
        user-select: none;
        cursor: grab
    }

        .joy b {
            position: absolute;
            font-size: 9px;
            color: #b4bbd0;
            font-weight: 400
        }

        .joy .u {
            left: 38px;
            top: 5px
        }

        .joy .d {
            left: 38px;
            bottom: 5px
        }

        .joy .l {
            left: 7px;
            top: 36px
        }

        .joy .r {
            right: 7px;
            top: 36px
        }

    .knob {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 38px;
        height: 38px;
        margin: -19px 0 0 -19px;
        border-radius: 50%;
        background: radial-gradient(circle at 35% 30%,#7b74f0,var(--ac));
        box-shadow: 0 3px 8px #4f46e550;
        pointer-events: none
    }

    .modes {
        position: absolute;
        left: 12px;
        top: 12px;
        display: flex;
        flex-direction: column;
        gap: 3px;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 8px;
        box-shadow: var(--sh);
        min-width: 150px;
        z-index: 5
    }

        .modes h6 {
            font-size: 10.5px;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--mu);
            margin: 0 4px 4px
        }

    .md {
        display: flex;
        gap: 10px;
        align-items: center;
        padding: 7px 9px;
        border-radius: 9px;
        font-size: 12.5px;
        text-align: left
    }

        .md:hover {
            background: var(--soft)
        }

        .md.on {
            background: var(--acs);
            color: var(--ac);
            font-weight: 600
        }

        .md svg {
            width: 20px;
            height: 20px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round
        }

    .sm {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 9px 10px;
        border-radius: 9px;
        font-size: 12.5px;
        margin-top: 5px;
        background: var(--soft);
        border: 1px solid var(--line)
    }

        .sm span {
            flex: 1
        }

        .sm.ok i:first-child {
            color: #16a34a
        }

        .sm.bad {
            cursor: pointer;
            background: #fffaf0;
            border-color: #fde7b0
        }

            .sm.bad i:first-child {
                color: #d97706
            }

        .sm i:last-child {
            color: var(--mu)
        }

    .ck {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
        font-size: 12.5px;
        cursor: pointer;
        margin: 0
    }

        .ck input {
            width: 16px;
            height: 16px;
            padding: 0;
            accent-color: var(--ac)
        }

        .ck.sub {
            padding-left: 16px;
            color: var(--mu)
        }

        .ck.dis {
            opacity: .4;
            pointer-events: none
        }

    .sh {
        font-size: 11px;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--mu);
        font-weight: 700;
        margin: 14px 0 8px;
        padding-top: 12px;
        border-top: 1px solid var(--line)
    }

        .sh:first-child {
            border: 0;
            padding-top: 0;
            margin-top: 0
        }

    .tl span i {
        font-size: 9px;
        display: inline-block;
        margin-left: 2px
    }

    .icg {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 8px;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 10px;
        background: #fff;
        max-height: 300px;
        overflow: auto
    }

    .ig {
        height: 56px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        color: var(--tx);
        border: 1px solid transparent;
        background: none;
        cursor: pointer
    }

        .ig:hover {
            background: var(--soft)
        }

        .ig.on {
            background: var(--ac);
            color: #fff
        }

        .ig svg {
            width: 28px;
            height: 28px
        }

    .ldr {
        position: absolute;
        inset: 0;
        z-index: 50;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 14px;
        background: #fcfdff;
        transition: opacity .25s
    }

        .ldr.done {
            opacity: 0;
            pointer-events: none
        }

        .ldr b {
            width: 40px;
            height: 40px;
            border: 4px solid #e4e8f2;
            border-top-color: #4f46e5;
            border-radius: 50%;
            animation: ldrSpin .8s linear infinite
        }

        .ldr span {
            font: 600 13px system-ui, sans-serif;
            color: #6b7694
        }
    @@keyframes ldrSpin {
        to {
            transform: rotate(360deg)
        }
    }

    /* add */
    .logo img {
        height: 32px;
        width: auto;
        display: block;
    }
</style>

<div class="editor-root">

    <div class="top">
        <div class="logo"><img src="images/seatsq-logo.png" alt="SeatsQ" /></div><span class="crumb">/</span>
        <input id="title" class="ttl" placeholder="Enter chart name" maxlength="100" autocomplete="off" />
        <div class="sp"></div>
        <button class="bt" id="cancel" @onclick="CancelChart"><i class="fa-solid fa-xmark"></i> Cancel</button>
        <button class="bt" id="copy" @onclick="CopyChart"><i class="fa-regular fa-copy"></i> Copy chart</button>
        <button class="bt pr" id="save" @onclick="SaveChart"><i class="fa-regular fa-floppy-disk"></i> Save layout</button>
        <div class="av" id="av">D<div class="mn" id="mn"><div>user@email.com</div><button id="logout" @onclick="Logout"><i class="fa-solid fa-arrow-right-from-bracket"></i> Logout</button></div></div>
    </div>

    <div class="bar">
        <div id="rib" style="display:flex;gap:4px">
            <div class="grp">
                <div class="gi">
                    <button class="tl on" data-t="select" title="Select (V)"><i class="fa-solid fa-arrow-pointer"></i>Select</button>
                    <button class="tl" data-t="pan" title="Pan (H)"><i class="fa-regular fa-hand"></i>Pan</button>
                    <button class="tl" data-t="seat" title="Select seats (E)"><i class="fa-solid fa-chair"></i>Seat</button>
                </div><span class="cap">NAVIGATE</span>
            </div>
            <div class="gs"></div>
            <div class="grp">
                <div class="gi">
                    <button class="tl" data-t="row" title="Rows (R) - single row, multiple rows or by segments"><i class="fa-solid fa-grip-lines"></i><span>Rows<i class="fa-solid fa-chevron-down"></i></span></button>
