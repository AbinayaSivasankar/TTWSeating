@page "/index/{ChartID}"
@using DataLayer;
@using System.Collections.Specialized
@using System.Data
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Newtonsoft.Json
@inject NavigationManager NavManager;
@inject ProtectedSessionStorage sessionStorage;
@inject IJSRuntime JS

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    /* ─── RESET & ROOT ─── */
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        /* Warm Terracotta palette */
        --bg-body: #f7f2eb;
        --bg-surface: #fefcf8;
        --bg-card: #ffffff;
        --bg-elevated: #f5ede4;
        --bg-hover: #f0e6da;
        --bg-active: #e8d9c9;
        --border-subtle: #e5d6c6;
        --border-medium: #d4c0ab;
        --border-strong: #bfa692;
        --text-primary: #3a2c24;
        --text-secondary: #6b5747;
        --text-muted: #a48d7a;
        --text-inverse: #ffffff;
        --accent-1: #c9694b;
        --accent-1-dark: #a84f34;
        --accent-1-light: #e8a187;
        --accent-1-glow: rgba(201, 105, 75, 0.20);
        --accent-2: #d99b7a;
        --accent-success: #6b8f71;
        --accent-danger: #c05a4a;
        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 16px;
        --radius-xl: 20px;
        --radius-full: 9999px;
        --shadow-card: 0 2px 16px rgba(90, 60, 40, 0.06), 0 1px 3px rgba(90, 60, 40, 0.03);
        --shadow-elevated: 0 8px 32px rgba(90, 60, 40, 0.08);
        --shadow-glow: 0 0 30px rgba(201, 105, 75, 0.12);
        --font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1);
        /* Warning Colors */
        --warning-1: #ff9800;
        --warning-2: #f57c00;
        --warning-glow: rgba(255, 152, 0, 0.4);
    }

    html, body {
        height: 100%;
        font-family: var(--font);
        background: var(--bg-body);
        color: var(--text-primary);
        -webkit-font-smoothing: antialiased;
    }

    /* ─── SCROLLBAR ─── */
    ::-webkit-scrollbar {
        width: 4px;
        height: 4px;
    }

    ::-webkit-scrollbar-track {
        background: var(--bg-body);
    }

    ::-webkit-scrollbar-thumb {
        background: var(--accent-1-light);
        border-radius: var(--radius-full);
    }

    /* ─── APP SHELL ─── */
    .terracotta-shell {
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
        background: var(--bg-body);
    }

    /* ─── TOP BAR ─── */
    .terracotta-topbar {
        height: 56px;
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border-subtle);
        display: flex;
        align-items: center;
        padding: 0 20px;
        gap: 16px;
        flex-shrink: 0;
        z-index: 100;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }

    .terracotta-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 16px;
        font-weight: 700;
        color: var(--text-primary);
        letter-spacing: -0.02em;
        white-space: nowrap;
    }

        .terracotta-brand .brand-icon {
            width: 32px;
            height: 32px;
            border-radius: var(--radius-md);
            background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            color: white;
            box-shadow: 0 2px 12px var(--accent-1-glow);
        }

        .terracotta-brand .brand-dot {
            color: var(--accent-2);
        }

    .terracotta-title-input {
        background: var(--bg-body);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        color: var(--text-primary);
        padding: 6px 14px;
        font-size: 13px;
        font-family: var(--font);
        width: 220px;
        outline: none;
        transition: var(--transition);
    }

        .terracotta-title-input:focus {
            border-color: var(--accent-1);
            box-shadow: 0 0 0 3px var(--accent-1-glow);
            background: var(--bg-surface);
        }

        .terracotta-title-input::placeholder {
            color: var(--text-muted);
        }

    .terracotta-spacer {
        flex: 1;
    }

    .terracotta-topbar-divider {
        width: 1px;
        height: 26px;
        background: var(--border-subtle);
        margin: 0 6px;
    }

    .terracotta-tb-btn {
        width: 34px;
        height: 34px;
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--text-muted);
        transition: var(--transition);
        position: relative;
        background: transparent;
        border: none;
        font-size: 14px;
    }

        .terracotta-tb-btn:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
        }

        .terracotta-tb-btn .terracotta-tip {
            position: absolute;
            bottom: -32px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--bg-surface);
            color: var(--text-secondary);
            font-size: 10px;
            padding: 2px 10px;
            border-radius: var(--radius-sm);
            white-space: nowrap;
            pointer-events: none;
            opacity: 0;
            transition: var(--transition);
            border: 1px solid var(--border-subtle);
            font-weight: 500;
            box-shadow: var(--shadow-elevated);
        }

        .terracotta-tb-btn:hover .terracotta-tip {
            opacity: 1;
            bottom: -34px;
        }

    .terracotta-avatar {
        width: 34px;
        height: 34px;
        border-radius: var(--radius-full);
        background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 600;
        color: white;
        cursor: pointer;
        margin-left: 4px;
        border: 2px solid var(--bg-surface);
        box-shadow: 0 2px 10px var(--accent-1-glow);
        transition: var(--transition);
    }

        .terracotta-avatar:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 20px var(--accent-1-glow);
        }

    /* ─── UNIFIED TOOLBAR (horizontal) ─── */
    .terracotta-toolbar {
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border-subtle);
        padding: 6px 20px;
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
        overflow-x: auto;
        flex-wrap: nowrap;
        box-shadow: 0 1px 2px rgba(0,0,0,0.01);
    }

        .terracotta-toolbar .terracotta-tb-group {
            display: flex;
            align-items: center;
            gap: 2px;
            padding: 0 8px;
            border-right: 1px solid var(--border-subtle);
        }

            .terracotta-toolbar .terracotta-tb-group:last-child {
                border-right: none;
            }

        .terracotta-toolbar .terracotta-tb-label {
            font-size: 9px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin-right: 6px;
            white-space: nowrap;
        }

    .terracotta-tool-btn {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        border-radius: var(--radius-full);
        border: none;
        background: transparent;
        color: var(--text-secondary);
        font-size: 12px;
        font-weight: 500;
        font-family: var(--font);
        cursor: pointer;
        transition: var(--transition);
        white-space: nowrap;
    }

        .terracotta-tool-btn i {
            font-size: 14px;
            color: var(--text-muted);
            transition: var(--transition);
        }

        .terracotta-tool-btn:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
        }

            .terracotta-tool-btn:hover i {
                color: var(--text-secondary);
            }

        .terracotta-tool-btn.active {
            background: var(--bg-active);
            color: var(--accent-1);
            box-shadow: 0 0 0 1.5px var(--accent-1-glow);
        }

            .terracotta-tool-btn.active i {
                color: var(--accent-1);
            }

        .terracotta-tool-btn.danger {
            color: var(--accent-danger);
        }

            .terracotta-tool-btn.danger i {
                color: var(--accent-danger);
            }

            .terracotta-tool-btn.danger:hover {
                background: rgba(192, 90, 74, 0.08);
            }

    /* ─── WORKSPACE ─── */
    .terracotta-workspace {
        display: flex;
        flex: 1;
        overflow: hidden;
        gap: 0;
    }

    /* ─── LEFT SIDEBAR (icons only) ─── */
    .terracotta-sidebar {
        width: 56px;
        background: var(--bg-surface);
        border-right: 1px solid var(--border-subtle);
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 12px 0;
        gap: 4px;
        flex-shrink: 0;
        overflow-y: auto;
    }

    .terracotta-sidebar-divider {
        width: 24px;
        height: 1px;
        background: var(--border-subtle);
        margin: 6px 0;
    }

    .terracotta-sb-btn {
        width: 40px;
        height: 40px;
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--text-muted);
        transition: var(--transition);
        border: none;
        background: transparent;
        font-size: 16px;
        position: relative;
    }

        .terracotta-sb-btn:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
        }

        .terracotta-sb-btn.active {
            background: var(--bg-active);
            color: var(--accent-1);
            box-shadow: 0 0 0 1.5px var(--accent-1-glow);
        }

        .terracotta-sb-btn.danger {
            color: var(--accent-danger);
        }

            .terracotta-sb-btn.danger:hover {
                background: rgba(192, 90, 74, 0.08);
            }

        .terracotta-sb-btn .terracotta-sb-tip {
            position: absolute;
            left: 40px;
            top: 50%;
            transform: translateY(-50%);
            background: var(--bg-surface);
            color: var(--text-secondary);
            font-size: 10px;
            padding: 2px 10px;
            border-radius: var(--radius-sm);
            white-space: nowrap;
            pointer-events: none;
            opacity: 0;
            transition: var(--transition);
            border: 1px solid var(--border-subtle);
            font-weight: 500;
            box-shadow: var(--shadow-elevated);
            z-index: 200;
        }

        .terracotta-sb-btn:hover .terracotta-sb-tip {
            opacity: 1;
            left: 46px;
        }

    /* ─── MAIN CANVAS AREA ─── */
    .terracotta-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 14px 16px 16px 16px;
        gap: 0;
        overflow: hidden;
        position: relative;
        background: var(--bg-body);
    }

    .terracotta-canvas-card {
        flex: 1;
        background: var(--bg-surface);
        border-radius: var(--radius-xl);
        border: 1px solid var(--border-subtle);
        box-shadow: var(--shadow-card);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        position: relative;
    }

    .terracotta-canvas-header {
        display: flex;
        align-items: center;
        padding: 10px 18px;
        border-bottom: 1px solid var(--border-subtle);
        gap: 12px;
        flex-shrink: 0;
        background: rgba(255,255,255,0.5);
    }

        .terracotta-canvas-header .terracotta-ch-label {
            font-size: 10px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .terracotta-canvas-header .terracotta-ch-title {
            flex: 1;
            font-size: 15px;
            font-weight: 500;
            border: none;
            outline: none;
            background: transparent;
            color: var(--text-primary);
            font-family: var(--font);
            padding: 2px 0;
        }

            .terracotta-canvas-header .terracotta-ch-title::placeholder {
                color: var(--text-muted);
            }

        .terracotta-canvas-header .terracotta-ch-badge {
            font-size: 11px;
            color: var(--text-secondary);
            background: var(--bg-body);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-full);
            padding: 2px 14px;
            font-weight: 500;
        }

    .terracotta-canvas-inner {
        flex: 1;
        position: relative;
        background: #fdfaf7;
        background-image: radial-gradient(circle, #e5d6c6 1px, transparent 1px);
        background-size: 24px 24px;
        overflow: hidden;
    }

    #myCanvas {
        width: 100%;
        height: 100%;
        position: absolute;
        inset: 0;
    }

        #myCanvas canvas {
            border-radius: 0 0 var(--radius-xl) var(--radius-xl);
        }

    /* ─── FLOATING TOOLBAR ─── */
    .terracotta-float-bar {
        position: absolute;
        top: 14px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 2px;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: 4px 8px;
        box-shadow: var(--shadow-elevated);
        z-index: 50;
        backdrop-filter: blur(10px);
    }

        .terracotta-float-bar .terracotta-ft-btn {
            width: 32px;
            height: 32px;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--text-muted);
            transition: var(--transition);
            border: none;
            background: transparent;
            font-size: 13px;
            position: relative;
        }

            .terracotta-float-bar .terracotta-ft-btn:hover {
                background: var(--bg-hover);
                color: var(--text-primary);
            }

        .terracotta-float-bar .terracotta-ft-sep {
            width: 1px;
            height: 20px;
            background: var(--border-subtle);
            margin: 0 4px;
        }

        .terracotta-float-bar .terracotta-ft-btn .terracotta-tip {
            position: absolute;
            bottom: -30px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--bg-surface);
            color: var(--text-secondary);
            font-size: 10px;
            padding: 2px 10px;
            border-radius: var(--radius-sm);
            white-space: nowrap;
            pointer-events: none;
            opacity: 0;
            transition: var(--transition);
            border: 1px solid var(--border-subtle);
            font-weight: 500;
            box-shadow: var(--shadow-elevated);
        }

        .terracotta-float-bar .terracotta-ft-btn:hover .terracotta-tip {
            opacity: 1;
            bottom: -34px;
        }

    /* ─── CANVAS ACTIONS ─── */
    .terracotta-canvas-actions {
        position: absolute;
        bottom: 20px;
        right: 20px;
        display: flex;
        gap: 12px;
        z-index: 50;
    }

    .terracotta-btn {
        padding: 8px 20px;
        font-size: 12px;
        font-weight: 600;
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: var(--transition);
        font-family: var(--font);
        border: none;
        letter-spacing: 0.02em;
        display: flex;
        align-items: center;
        gap: 7px;
    }

        .terracotta-btn:active {
            transform: scale(0.96);
        }

    .terracotta-btn-primary {
        background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
        color: white;
        box-shadow: 0 4px 16px var(--accent-1-glow);
    }

        .terracotta-btn-primary:hover {
            box-shadow: 0 6px 24px var(--accent-1-glow);
            transform: translateY(-1px);
        }

    .terracotta-btn-ghost {
        background: var(--bg-body);
        color: var(--text-secondary);
        border: 1px solid var(--border-subtle);
    }

        .terracotta-btn-ghost:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
            border-color: var(--border-medium);
        }
    /* ========== WARNING BUTTON ========== */
    .warning-btn-primary {
        background: linear-gradient(135deg, var(--warning-1), var(--warning-2));
        color: white;
        box-shadow: 0 4px 16px var(--warning-glow);
        border: none;
        padding: 10px 24px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .warning-btn-primary:hover {
            box-shadow: 0 6px 24px rgba(255, 152, 0, 0.5);
            transform: translateY(-1px);
        }

        .warning-btn-primary:active {
            transform: translateY(0px);
            box-shadow: 0 2px 8px rgba(255, 152, 0, 0.3);
        }

    .btn-warning {
        background: linear-gradient(135deg, #ff9800, #f57c00);
        color: white;
        box-shadow: 0 4px 16px rgba(255, 152, 0, 0.4);
        border: none;
        padding: 10px 24px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-warning:hover {
            box-shadow: 0 6px 24px rgba(255, 152, 0, 0.5);
            transform: translateY(-1px);
        }
    /* ─── RIGHT PANEL ─── */
    .terracotta-right {
        width: 270px;
        background: var(--bg-surface);
        border-left: 1px solid var(--border-subtle);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        overflow-y: auto;
        padding: 16px 18px 20px;
        gap: 0;
    }

    .terracotta-panel-section {
        margin-bottom: 18px;
    }

        .terracotta-panel-section:last-child {
            margin-bottom: 0;
        }

    .terracotta-panel-label {
        font-size: 10px;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .terracotta-panel-label::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border-subtle);
        }

    .terracotta-field-label {
        font-size: 11px;
        font-weight: 500;
        color: var(--text-secondary);
        margin-top: 6px;
    }

        .terracotta-field-label:first-of-type {
            margin-top: 0;
        }

    .terracotta-select, .terracotta-input {
        width: 100%;
        font-size: 12px;
        padding: 6px 12px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-subtle);
        background: var(--bg-body);
        color: var(--text-primary);
        outline: none;
        font-family: var(--font);
        transition: var(--transition);
        appearance: auto;
    }

        .terracotta-select:focus, .terracotta-input:focus {
            border-color: var(--accent-1);
            box-shadow: 0 0 0 3px var(--accent-1-glow);
            background: var(--bg-surface);
        }

    /* Category chips */
    .terracotta-cat-manage {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 7px 14px;
        background: var(--accent-1-glow);
        color: var(--accent-1-dark);
        border: 1px solid rgba(201, 105, 75, 0.20);
        border-radius: var(--radius-md);
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        font-family: var(--font);
        transition: var(--transition);
        margin-bottom: 8px;
    }

        .terracotta-cat-manage:hover {
            background: rgba(201, 105, 75, 0.12);
            border-color: rgba(201, 105, 75, 0.35);
        }

    .terracotta-cat-chip {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 5px 12px;
        border-radius: var(--radius-md);
        border: 1px solid var(--border-subtle);
        margin-bottom: 4px;
        cursor: pointer;
        transition: var(--transition);
        font-size: 12px;
        color: var(--text-secondary);
        background: var(--bg-body);
    }

        .terracotta-cat-chip:hover {
            border-color: var(--border-medium);
            background: var(--bg-hover);
            color: var(--text-primary);
        }

    .terracotta-cat-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
        border: 1px solid var(--border-subtle);
    }

    .terracotta-cat-name {
        flex: 1;
        font-weight: 450;
    }

    .terracotta-cat-add {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 5px 12px;
        border-radius: var(--radius-md);
        border: 1px dashed var(--border-medium);
        font-size: 12px;
        color: var(--text-muted);
        cursor: pointer;
        transition: var(--transition);
        margin-top: 2px;
    }

        .terracotta-cat-add:hover {
            color: var(--accent-1);
            border-color: var(--accent-1);
            background: var(--accent-1-glow);
        }

    /* Validation */
    .terracotta-val-error {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding: 7px 12px;
        background: rgba(192, 90, 74, 0.06);
        border-left: 3px solid var(--accent-danger);
        border-radius: var(--radius-sm);
        font-size: 11px;
        color: var(--accent-danger);
        margin-top: 6px;
    }

    .terracotta-curved-btn {
        width: 100%;
        padding: 7px 14px;
        background: var(--bg-body);
        color: var(--text-secondary);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        font-size: 12px;
        font-family: var(--font);
        cursor: pointer;
        transition: var(--transition);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

        .terracotta-curved-btn:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
            border-color: var(--border-medium);
        }

    .terracotta-apply-btn {
        width: 100%;
        margin-top: 10px;
        padding: 8px 16px;
        background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
