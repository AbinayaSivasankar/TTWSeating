    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await js.InvokeVoidAsync("registerDropdownClickHandler", DotNetObjectReference.Create(this));
            // Render previews for all charts
            await js.InvokeVoidAsync("renderAllPreviews");
        }
        await base.OnAfterRenderAsync(firstRender);
    }

