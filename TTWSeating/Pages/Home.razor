        }

        .sq-page .sq-fav.on {
            color: var(--color-warning, #F5B301);
        }

    @@media (max-width: 520px) {
        .sq-page .sq-chart-grid.list .sq-fav {
            top: 5px;
            left: 5px;
            width: 24px;
            height: 24px;
        }

            .sq-page .sq-chart-grid.list .sq-fav svg {
                width: 12px;
                height: 12px;
            }
    }

    /* ─── Recently updated: real previews ─── */
    .sq-page .sq-recent-thumb {
        position: relative;
    }

        .sq-page .sq-recent-thumb canvas {
            position: absolute;
            inset: 0;
            width: 100% !important;
            height: 100% !important;
            display: block;
        }

    /* ─── Chart card redesign (grid view only; list view is unchanged) ─── */
    .sq-page .sq-stage-pill {
        display: none;
    }

    .sq-page .sq-chart-grid:not(.list) .sq-stage-pill {
        display: block;
        position: absolute;
        top: 9%;
        left: 50%;
        width: 26%;
        height: 8px;
        border-radius: 999px;
        background: var(--color-text-muted);
        opacity: .28;
        transform: translateX(-50%);
        pointer-events: none;
    }

    .sq-page .sq-chart-grid:not(.list) .sq-chart-card.terracotta-row-card {
        gap: 12px;
        padding: 12px;
        border-radius: 26px;
    }

    .sq-page .sq-chart-grid:not(.list) .sq-thumb.chart-preview-container {
        border-radius: 20px;
    }

    .sq-page .sq-chart-grid:not(.list) .sq-chart-info {
        gap: 5px;
        padding: 4px 6px 0;
    }

    .sq-page .sq-chart-grid:not(.list) .sq-chart-title {
        font-size: 17px;
        font-weight: 700;
        letter-spacing: -.01em;
    }

    .sq-page .sq-chart-grid:not(.list) .sq-chart-id {
        font-size: 14px;
    }

    .sq-page .sq-chart-grid:not(.list) .sq-chart-key {
        font-size: 12px;
        gap: 6px;
    }

        .sq-page .sq-chart-grid:not(.list) .sq-chart-key .sq-icon-btn {
            width: 24px;
            height: 24px;
        }

    .sq-page .sq-chart-grid:not(.list) .sq-chart-actions {
        gap: 8px;
        padding: 2px 4px 2px;
    }

        .sq-page .sq-chart-grid:not(.list) .sq-chart-actions .sq-btn-dark {
            height: 44px;
            font-size: 14px;
            border-radius: 24px;
        }

        .sq-page .sq-chart-grid:not(.list) .sq-chart-actions .sq-btn-out {
            width: 44px;
            height: 44px;
            background: var(--color-surface);
        }

            .sq-page .sq-chart-grid:not(.list) .sq-chart-actions .sq-btn-out svg {
                width: 17px;
                height: 17px;
            }

    /* favorite star: filled when on, matches the new design */
    .sq-page .sq-fav {
        color: var(--color-text);
    }

        .sq-page .sq-fav:hover, .sq-page .sq-fav.on {
            color: var(--color-text);
        }

    .sq-page .sq-chart-grid:not(.list) .sq-fav {
        top: 10px;
        left: 10px;
        width: 36px;
        height: 36px;
    }

    /* ─── match index page type scale ─── */
    .sq-page .sq-header-title {
        font-size: 18px;
    }

    .sq-page .sq-h2,
    .sq-page .sq-rail-title {
        font-size: 14.5px;
    }
    .sq-page .sq-stat-value {
        font-size: 32px;
    }

    .sq-page .sq-chart-grid:not(.list) .sq-chart-title {
        font-size: 14.5px;
    }


    .sq-page .sq-stat-note,
    .sq-page .sq-chart-status,
    .sq-page .sq-recent-id,
    .sq-page .sq-tip-text {
        font-size: 11.5px;
    }
</style>

<div class="sq-page">
    <div class="sq-shell">
        <SeatsQSidebar ActiveView="@activeView" UserEmail="@UserEmail" ViewChanged="SetView" />

        <main class="sq-content">
            <header class="sq-header">
                <div class="sq-header-actions @(activeView == "settings" ? "settings" : "")">
                    @if (activeView == "charts")
                    {
                        <label class="sq-search">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
                            <input type="search" placeholder="Search anything..." aria-label="Search charts" @bind="searchText" @bind:event="oninput" />
                        </label>
                        <button type="button" class="sq-btn-dark sq-create" style="box-shadow: inset 0 0 1px #9590ff, inset 0 -2px 0 #0003, 0 1px 2px #0006, 0 8px 24px -6px #5b5bf099 !important;" @onclick="CreateChart">Create</button>
                        <span class="sq-header-icon" aria-hidden="true">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"></path></svg>
                        </span>
                        <span class="sq-header-icon" aria-hidden="true">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z"></path></svg>
                        </span>
                    }
                    <div class="sq-avatar-wrap avatar-wrapper" @onclick="ToggleDropdown" @onclick:stopPropagation="true">
                        <button type="button" class="sq-avatar" aria-label="Open account menu">@UserInitial</button>

                        <div class="sq-menu sq-profile-menu @(showDropdown ? "show" : "")" @onclick:stopPropagation="true">
                            <div class="sq-pm-head">
                                <span class="sq-pm-avatar">@UserInitial</span>
                                <div class="sq-pm-who">
                                    <span class="sq-pm-name">@(string.IsNullOrWhiteSpace(UserName) ? "My account" : UserName)</span>
                                    <span class="sq-pm-email">@UserEmail</span>
                                </div>
                            </div>

                            <div class="sq-pm-section">
                                <div class="sq-pm-title">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="15" r="4"></circle><path d="m11 12 9-9M16 7l3 3M14 9l2 2"></path></svg>
                                    API keys
                                </div>

                                <div class="sq-pk">
                                    <div class="sq-pk-top">
                                        <span class="sq-pk-label">Public key</span>
                                        <span class="sq-pk-badge public">Client-side</span>
                                    </div>
                                    <div class="sq-pk-field">
                                        <code class="sq-pk-value" title="@PublicKey">@PublicKey</code>
                                        <button type="button" class="sq-pk-btn" title="Copy public key" aria-label="Copy public key"
                                                @onclick='() => CopyText(PublicKey, "Public")'>
                                            @if (PublicCopied)
                                            {
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>
                                            }
                                            else
                                            {
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="13" height="13" rx="2"></rect><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"></path></svg>
                                            }
                                        </button>
                                    </div>
                                </div>

                                <div class="sq-pk">
                                    <div class="sq-pk-top">
                                        <span class="sq-pk-label">Secret key</span>
                                        <span class="sq-pk-badge secret">Server only</span>
                                    </div>
                                    <div class="sq-pk-field">
                                        <code class="sq-pk-value" title="@(secretVisible ? SecretKey : "Hidden")">@(secretVisible ? SecretKey : MaskKey(SecretKey))</code>
                                        <button type="button" class="sq-pk-btn" title="@(secretVisible ? "Hide" : "Show") secret key" aria-label="Toggle secret key visibility"
                                                @onclick="() => secretVisible = !secretVisible">
                                            @if (secretVisible)
                                            {
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.9 17.9A10.1 10.1 0 0 1 12 20c-7 0-10-8-10-8a17.7 17.7 0 0 1 4.1-5.4M9.9 4.2A9.7 9.7 0 0 1 12 4c7 0 10 8 10 8a17.8 17.8 0 0 1-2.2 3.2M1 1l22 22M14.1 14.1a3 3 0 1 1-4.2-4.2"></path></svg>
                                            }
                                            else
                                            {
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-8 10-8 10 8 10 8-3.5 8-10 8S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                            }
                                        </button>
                                        <button type="button" class="sq-pk-btn" title="Copy secret key" aria-label="Copy secret key"
                                                @onclick='() => CopyText(SecretKey, "Secret")'>
                                            @if (SecretCopied)
                                            {
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>
                                            }
                                            else
                                            {
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="13" height="13" rx="2"></rect><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"></path></svg>
                                            }
                                        </button>
                                    </div>
                                </div>

                                <p class="sq-pm-hint">Use the public key in your embed. Never expose the secret key in client-side code.</p>
                            </div>

                            <div class="sq-pm-foot">
                                <button type="button" class="sq-pm-logout" @onclick="Logout">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3"></path><path d="M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6"></path></svg>
                                    Log out
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            @if (!string.IsNullOrEmpty(flashMessage))
            {
                <div class="sq-flash-toast" role="status">@flashMessage</div>
            }

            @if (activeView == "charts")
            {
                <div class="sq-dashboard-body">
                    <main class="sq-dashboard-main">
                        <section class="sq-section" aria-label="Overview">
                            <h2 class="sq-h2">Overview</h2>
                            <div class="sq-stats">
                                <div class="sq-stat first">
                                    <span class="sq-stat-label">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="2"></rect><rect x="14" y="3" width="7" height="7" rx="2"></rect><rect x="3" y="14" width="7" height="7" rx="2"></rect><rect x="14" y="14" width="7" height="7" rx="2"></rect></svg>
                                        Charts
                                    </span>
                                    <span class="sq-stat-value">@TotalCount</span>
                                    <span class="sq-stat-note">in your workspace</span>
                                </div>
                                <div class="sq-stat">
                                    <span class="sq-stat-label">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                                        Saved layouts
                                    </span>
                                    <span class="sq-stat-value">@LayoutCount</span>
                                    <span class="sq-stat-note">with a saved seating layout</span>
                                </div>
                                <div class="sq-stat">
                                    <span class="sq-stat-label">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20a6.5 6.5 0 0 1 13 0"></path><path d="M17 11a3 3 0 0 0 0-6"></path><path d="M18 14a5 5 0 0 1 3.5 4.8"></path></svg>
                                        Chart keys
                                    </span>
                                    <span class="sq-stat-value">@ChartKeyCount</span>
                                    <span class="sq-stat-note">available to preview</span>
                                </div>
                            </div>
                        </section>

                        @if (TotalCount > 0)
                        {
                            <section class="sq-section" aria-label="Charts">
                                <div class="sq-toolbar">
                                    <h2 class="sq-h2">All charts <small>@(ShownCount == TotalCount ? TotalCount.ToString() : $"{ShownCount} of {TotalCount}")</small></h2>
                                    <label class="sq-select-wrap">
                                        <select aria-label="Filter charts" @bind="chartFilter">
                                            <option value="all">All charts</option>
                                            <option value="favorites">Favorites</option>
                                            <option value="with-layout">With layout</option>
                                            <option value="without-layout">Without layout</option>
                                        </select>
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#4A4A4A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                                    </label>
                                    <label class="sq-select-wrap">
                                        <select aria-label="Sort charts" @bind="chartSort">
                                            <option value="recent">Recently added</option>
                                            <option value="az">Name A to Z</option>
                                            <option value="za">Name Z to A</option>
                                        </select>
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#4A4A4A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                                    </label>
                                    <div class="sq-view-toggle" role="group" aria-label="View">
                                        <button type="button" class="@(isGrid ? "on" : "")" aria-label="Grid view" aria-pressed="@isGrid" @onclick="() => isGrid = true">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="2"></rect><rect x="14" y="3" width="7" height="7" rx="2"></rect><rect x="3" y="14" width="7" height="7" rx="2"></rect><rect x="14" y="14" width="7" height="7" rx="2"></rect></svg>
                                        </button>
                                        <button type="button" class="@(!isGrid ? "on" : "")" aria-label="List view" aria-pressed="@(!isGrid)" @onclick="() => isGrid = false">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
                                        </button>
                                    </div>
                                </div>
                                @if (ShownCount == 0)
                                {
                                    <div class="sq-empty">
                                        <strong>@(chartFilter == "favorites" && string.IsNullOrWhiteSpace(searchText) ? "No favorites yet" : "No charts found")</strong>
                                        <span>@(chartFilter == "favorites" && string.IsNullOrWhiteSpace(searchText) ? "Tap the star on a chart to add it here." : "Try a different search or filter.")</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="sq-chart-grid @(isGrid ? "" : "list")">
                                        @foreach (DataRow dr in ShownCharts)
                                        {
                                            var chartId = dr["chart_id"]?.ToString() ?? "";
                                            var chartJson = dr["chart_json"]?.ToString() ?? "";
                                            var chartTitle = dr["chart_title"]?.ToString() ?? "Untitled chart";
                                            var chartKey = dr["chart_key"]?.ToString() ?? "";
                                            var hasLayout = !string.IsNullOrWhiteSpace(chartJson);
                                            var isFav = favorites.Contains(chartId);
                                            var dateText = ChartDate(dr);

                                            <article @key="chartId" class="sq-chart-card terracotta-row-card @(SelectedChartId == chartId ? "active" : "")"
                                                     @onclick="() => SelectChart(chartId)"
                                                     data-chart-json="@chartJson"
                                                     data-chart-id="@chartId">
                                                <div class="sq-chart-top">
                                                    <div class="sq-thumb chart-preview-container">
                                                        <canvas id="preview-@chartId" width="64" height="64"></canvas>
                                                        <div class="preview-placeholder" aria-hidden="true">
                                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v14H4z"></path><path d="m4 15 4-4 4 4 3-3 5 5"></path><circle cx="9" cy="9" r="1"></circle></svg>
                                                        </div>
                                                        <button type="button" class="sq-fav @(isFav ? "on" : "")"
                                                                title="@(isFav ? "Remove from favorites" : "Add to favorites")"
                                                                aria-label="@(isFav ? "Remove from favorites" : "Add to favorites")"
                                                                aria-pressed="@(isFav ? "true" : "false")"
                                                                @onclick:stopPropagation="true"
                                                                @onclick="() => ToggleFavorite(chartId)">
                                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="@(isFav ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z"></path></svg>
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="sq-chart-info">
                                                    <div class="sq-chart-title-line">
                                                        <div class="sq-chart-title" title="@chartTitle">@chartTitle</div>
                                                        <span class="sq-chart-status @(hasLayout ? "active" : "")">@(hasLayout ? "Active" : "Draft")</span>
                                                    </div>
                                                    <div class="sq-chart-id">@(string.IsNullOrEmpty(dateText) ? $"Chart #{chartId}" : dateText)</div>
                                                    <div class="sq-chart-key">
                                                        <span>@chartKey</span>
                                                        <button type="button" class="sq-icon-btn" title="Copy chart key" aria-label="Copy chart key"
                                                                @onclick:stopPropagation="true"
                                                                @onclick='() => CopyText(chartKey, "Chartkey", chartId)'>
                                                            @if (ChartKeyCopied == chartId)
                                                            {
                                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>
                                                            }
                                                            else
                                                            {
                                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="13" height="13" rx="2"></rect><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"></path></svg>
                                                            }
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="sq-chart-actions">
                                                    <a href="@($"{NavManager.BaseUri}counter/{chartKey}")" style=" box-shadow: inset 0 0 1px #9590ff, inset 0 -2px 0 #0003, 0 1px 2px #0006, 0 8px 24px -6px #5b5bf099;a"
                                                       target="_blank" rel="noopener noreferrer" class="sq-btn-dark"
                                                       @onclick:stopPropagation="true">
                                                        Open
                                                    </a>
                                                    <button type="button" class="sq-btn-out" style="inset 0 0 1px #ffffff, inset 0 -2px 0 #ffffff33, 0 1px 2px #13131366, 0 8px 24px -6px #b2b2b299 !important" title="Edit chart" aria-label="Edit chart" @onclick:stopPropagation="true" @onclick="() => EditChart(chartId)">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                                                    </button>
                                                    <button type="button" class="sq-btn-out" title="Copy share link" aria-label="Copy share link"
                                                            @onclick:stopPropagation="true" @onclick='() => CopyText($"{NavManager.BaseUri}counter/{chartKey}", "Share", chartId)'>
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"></path></svg>
                                                    </button>
                                                </div>
                                            </article>
                                        }
                                    </div>
                                }
                            </section>
                        }
                        else
                        {
                            <div class="sq-empty">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"></rect><path d="M7 8h10M7 12h6M7 16h3"></path></svg>
                                <strong>No charts yet</strong>
                                <span>Create your first seating chart to get started.</span>
                                <button style=" box-shadow: inset 0 0 1px #9590ff, inset 0 -2px 0 #0003, 0 1px 2px #0006, 0 8px 24px -6px #5b5bf099 !important;" type="button" class="sq-btn-dark" @onclick="CreateChart">Create chart</button>
                            </div>
                        }
                    </main>
                    <aside class="sq-dashboard-rail">
                        <section class="sq-section" aria-label="Recent charts">
                            <h2 class="sq-rail-title">Recently updated</h2>
                            @foreach (DataRow recentChart in RecentCharts)
                            {
                                var recentId = recentChart["chart_id"]?.ToString() ?? "";
                                var recentTitle = recentChart["chart_title"]?.ToString() ?? "Untitled chart";
                                var recentJson = recentChart["chart_json"]?.ToString() ?? "";
                                <button type="button" class="sq-recent-row" @key="recentId" data-chart-json="@recentJson" @onclick="() => SelectChart(recentId)">
                                    <span class="sq-recent-thumb" aria-hidden="true">
                                        <canvas width="42" height="42"></canvas>
                                        <svg class="sq-recent-fallback" viewBox="0 0 240 150">
                                            <path d="M24 50 Q120 120 216 50" fill="none" stroke="#BDBDBD" stroke-width="12" stroke-linecap="round" stroke-dasharray="0 19"></path>
                                            <path d="M40 82 Q120 138 200 82" fill="none" stroke="#40B76B" stroke-width="12" stroke-linecap="round" stroke-dasharray="0 19"></path>
                                        </svg>
                                    </span>
                                    <span class="sq-recent-name">@recentTitle</span>
                                    <span class="sq-recent-id">#@recentId</span>
                                </button>
                            }
                            <button type="button" class="sq-btn-out sq-rail-btn" @onclick="ShowAllCharts">All charts</button>
                        </section>
                        <section class="sq-section" aria-label="Start new">
                            <h2 class="sq-rail-title">Start new</h2>
                            <button type="button" class="sq-btn-dark sq-rail-btn" style="font-weight: 600;justify-content:center; box-shadow: inset 0 0 1px #9590ff, inset 0 -2px 0 #0003, 0 1px 2px #0006, 0 8px 24px -6px #5b5bf099 !important;" @onclick="CreateChart">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
                                Create chart
                            </button>
                            <button type="button" class="sq-btn-out sq-rail-btn" @onclick='() => SetView("settings")'>
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.7 1.7-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5v.2h-2.4v-.2a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1L8 17l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H6.7v-2.4h.2a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.9L8 8.6l1.7-1.7.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.5v-.2h2.4v.2a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.7 1.7-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.5 1h.2V14h-.2a1.7 1.7 0 0 0-1.5 1z"></path></svg>
                                Workspace settings
                            </button>
                        </section>
                        @if (showTip)
                        {
                            <section class="sq-tip">
                                <div class="sq-tip-body">
                                    <span class="sq-tip-title">Tip</span>
                                    <span class="sq-tip-text">Open a chart to preview its seating layout, or edit it to make changes.</span>
                                </div>
                                <button type="button" class="sq-tip-close" aria-label="Dismiss tip" @onclick="() => showTip = false">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
                                </button>
                            </section>
                        }
                    </aside>
                </div>
            }
            else
            {
                <div class="sq-settings-page">
                    <section class="sq-section sq-settings" aria-label="Workspace settings">
                        <div>
                            <h3 class="sq-h2">API keys</h3>
                            <p class="sq-page-subtitle">Use the public key in your client-side embed and keep the secret key on your server.</p>
                        </div>
                        <div class="sq-key-row">
                            <span class="sq-key-label">Secret key</span>
                            <span class="sq-key-value">@SecretKey</span>
                            <button type="button" class="sq-icon-btn" title="Copy secret key" aria-label="Copy secret key"
                                    @onclick='() => CopyText(SecretKey, "Secret")'>
                                @if (SecretCopied)
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>
                                }
                                else
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="13" height="13" rx="2"></rect><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"></path></svg>
                                }
                            </button>
                        </div>
                        <div class="sq-key-row">
                            <span class="sq-key-label">Public key</span>
                            <span class="sq-key-value">@PublicKey</span>
                            <button type="button" class="sq-icon-btn" title="Copy public key" aria-label="Copy public key"
                                    @onclick='() => CopyText(PublicKey, "Public")'>
                                @if (PublicCopied)
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>
                                }
                                else
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="13" height="13" rx="2"></rect><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"></path></svg>
                                }
                            </button>
                        </div>
                    </section>
                </div>
            }
        </main>
    </div>
</div>

@code {
    private string UserId { get; set; } = "0";
    private string SelectedChartId;
    private string searchText = "";
    private string activeView = "charts";
    private string chartFilter = "all";
    private string chartSort = "recent";
    private bool isGrid = true;
    private bool showTip = true;
    private bool secretVisible = false;
    private HashSet<string> favorites = new();

    public string ChartId { get; set; } = "0";
    public DataSet Charts { get; set; } = new DataSet();

    private IEnumerable<DataRow> ChartRows =>
        Charts.Tables.Count > 0 ? Charts.Tables[0].Rows.Cast<DataRow>() : Enumerable.Empty<DataRow>();

    private IEnumerable<DataRow> ShownCharts
    {
        get
        {
            IEnumerable<DataRow> rows = ChartRows;
            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var term = searchText.Trim();
                rows = rows.Where(row =>
                    (row["chart_title"]?.ToString() ?? "").Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (row["chart_id"]?.ToString() ?? "").Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            rows = chartFilter switch
            {
                "with-layout" => rows.Where(row => !string.IsNullOrWhiteSpace(row["chart_json"]?.ToString())),
                "without-layout" => rows.Where(row => string.IsNullOrWhiteSpace(row["chart_json"]?.ToString())),
                "favorites" => rows.Where(row => favorites.Contains(row["chart_id"]?.ToString() ?? "")),
                _ => rows
            };

            return chartSort switch
            {
                "az" => rows.OrderBy(row => row["chart_title"]?.ToString(), StringComparer.OrdinalIgnoreCase),
                "za" => rows.OrderByDescending(row => row["chart_title"]?.ToString(), StringComparer.OrdinalIgnoreCase),
                _ => rows.OrderByDescending(row => Convert.ToInt32(row["chart_id"]))
            };
        }
    }

    private IEnumerable<DataRow> RecentCharts =>
        ChartRows.OrderByDescending(row => Convert.ToInt32(row["chart_id"])).Take(4);
    private int TotalCount => ChartRows.Count();
    private int ShownCount => ShownCharts.Count();
    private int LayoutCount => ChartRows.Count(row => !string.IsNullOrWhiteSpace(row["chart_json"]?.ToString()));
    private int ChartKeyCount => ChartRows.Count(row => !string.IsNullOrWhiteSpace(row["chart_key"]?.ToString()));

    [Inject] NavigationManager NavManager { get; set; }
    [Inject] ProtectedSessionStorage sessionStorage { get; set; }
    [Inject] IJSRuntime js { get; set; }

    private string flashMessage = "";
    public bool showDropdown { get; set; } = false;
    public string PublicKey { get; set; } = "";
    public string SecretKey { get; set; } = "";
    public bool SecretCopied { get; set; } = false;
    public bool PublicCopied { get; set; } = false;
    public string ChartKeyCopied { get; set; } = "";
    public string ChartName { get; set; } = "";
    public string ChartKey { get; set; } = "";
    public string UserEmail { get; set; } = "";
    public string UserName { get; set; } = "";
    string UserInitial => !string.IsNullOrWhiteSpace(UserEmail) ? UserEmail.Substring(0, 1).ToUpper() : "?";

    protected override async Task OnInitializedAsync()
    {
        var result = await sessionStorage.GetAsync<string>("UserEmail");
        if (result.Success) UserEmail = result.Value;

        var userIdResult = await sessionStorage.GetAsync<string>("UserId");
        UserId = userIdResult.Value ?? "0";
        if (UserId != "" && UserId != "0")
        {
            GetAllCharts();
            GetUserKeys();
            var flash = await sessionStorage.GetAsync<string>("FlashMessage");
            if (flash.Success && !string.IsNullOrEmpty(flash.Value))
            {
                flashMessage = flash.Value;
                await sessionStorage.DeleteAsync("FlashMessage");   // show only once
                _ = HideFlashAsync();
            }
        }
        else
        {
            NavManager.NavigateTo("");
        }
    }

    private async Task HideFlashAsync()
    {
        await Task.Delay(4000);
        flashMessage = "";
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await js.InvokeVoidAsync("registerDropdownClickHandler", DotNetObjectReference.Create(this));

            // favorites live in the browser, so load them once JS is available
            if (UserId != "" && UserId != "0")
            {
                try
                {
                    var saved = await js.InvokeAsync<string[]>("sqLoadFavorites", UserId);
                    favorites = new HashSet<string>(saved ?? Array.Empty<string>());
                    StateHasChanged();
                }
                catch { /* favorites are optional */ }
            }
        }

        if (Charts != null && Charts.Tables.Count > 0 && Charts.Tables[0].Rows.Count > 0)
        {
            await js.InvokeVoidAsync("renderAllPreviews");
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    [JSInvokable]
    public void CloseDropdown()
    {
        showDropdown = false;
        secretVisible = false;
        StateHasChanged();
    }

    private void ToggleDropdown()
    {
        showDropdown = !showDropdown;
        secretVisible = false;
        StateHasChanged();
    }

    private void SetView(string view)
    {
        activeView = view;
        showDropdown = false;
        secretVisible = false;
    }

    private void ShowAllCharts()
    {
        searchText = "";
        chartFilter = "all";
        SetView("charts");
    }

    private async Task ToggleFavorite(string chartId)
    {
        if (!favorites.Add(chartId)) favorites.Remove(chartId);
        await js.InvokeVoidAsync("sqSaveFavorites", UserId, favorites.ToArray());
    }

    // Shows the first date-like column it finds; hidden if the table has none of these.
    private static readonly string[] DateColumns =
    {
        "updated_on", "modified_on", "updated_date", "modified_date", "updated_at", "last_modified",
        "created_on", "created_date", "created_at", "date_created", "chart_date", "chart_created_on"
    };

    private static string ChartDate(DataRow row)
    {
        foreach (var col in DateColumns)
        {
            if (!row.Table.Columns.Contains(col) || row[col] == DBNull.Value) continue;
            DateTime d;
            if (row[col] is DateTime dt) d = dt;
            else if (!DateTime.TryParse(row[col].ToString(), out d)) continue;
            return d.ToString("MMM d, yyyy, hh:mm tt", System.Globalization.CultureInfo.InvariantCulture);
        }
        return "";
    }

    private static string MaskKey(string key) =>
        string.IsNullOrEmpty(key) || key.Length < 9
            ? "••••••••••••"
            : key[..4] + new string('•', 12) + key[^4..];

    public void GetAllCharts()
    {
        cdlChart objChart = new cdlChart();
        NameValueCollection vncParams = new NameValueCollection();
        DataSet ds = new DataSet();
        vncParams.Add("chart_id", "0");
        vncParams.Add("log_id", UserId);
        vncParams.Add("chart_key", "");
        vncParams.Add("option", "U");
        objChart.GetChartCategory(vncParams, ref ds);
        if (ds != null)
        {
            Charts = ds;
        }
    }

    private void SelectChart(string chartId)
    {
        SelectedChartId = chartId;
    }

    private void CreateChart() => NavManager.NavigateTo("index/0");

    private void EditChart(string chartId) => NavManager.NavigateTo("index/" + chartId);

    private void GetUserKeys()
    {
        cdlUser objUser = new cdlUser();
        DataSet ds = new DataSet();
        NameValueCollection vncParams = new NameValueCollection();
        vncParams.Add("user_id", UserId);
        vncParams.Add("public_key", "");
        vncParams.Add("secret_key", "");
        vncParams.Add("user_email", "");
        vncParams.Add("option", "");
        objUser.GetUser(vncParams, ref ds);
        if (ds != null && ds.Tables[0].Rows.Count > 0)
        {
            DataRow dr = ds.Tables[0].Rows[0];
            PublicKey = dr["public_key"].ToString();
            SecretKey = dr["secret_key"].ToString();
            UserName = dr["user_name"].ToString();
        }
    }

    private async Task Logout()
    {
        showDropdown = false;
        secretVisible = false;
        await sessionStorage.SetAsync("UserId", "0");
        NavManager.NavigateTo(NavManager.BaseUri, true);
    }

    public async void CopyText(string text, string copiedType, string chartId = "")
    {
        await js.InvokeVoidAsync("CopyText", text);
        if (copiedType == "Public")
        {
            PublicCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            PublicCopied = false;
            StateHasChanged();
        }
        else if (copiedType == "Secret")
        {
            SecretCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            SecretCopied = false;
            StateHasChanged();
        }
        else if (copiedType == "Share")
        {
            flashMessage = "Share link copied";
            StateHasChanged();
            _ = HideFlashAsync();
        }
        else if (copiedType == "Chartkey")
        {
            ChartKeyCopied = chartId;
            StateHasChanged();
            await Task.Delay(2000);
            ChartKeyCopied = "";
            StateHasChanged();
        }
    }
}

<script>
    window.registerDropdownClickHandler = function (dotNetRef) {
        document.addEventListener('click', function (event) {
            var dropdown = document.querySelector('.avatar-wrapper');
            if (dropdown && !dropdown.contains(event.target)) {
                dotNetRef.invokeMethodAsync('CloseDropdown');
            }
        });
    };

    window.CopyText = function (text) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text);
        } else {
            var textarea = document.createElement("textarea");
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand("copy");
            document.body.removeChild(textarea);
        }
    };

    /* ─── favorites (per user, stored in this browser) ─── */
    window.sqLoadFavorites = function (userId) {
        try { return JSON.parse(localStorage.getItem('sq-favs-' + userId) || '[]'); }
        catch (e) { return []; }
    };

    window.sqSaveFavorites = function (userId, ids) {
        try { localStorage.setItem('sq-favs-' + userId, JSON.stringify(ids)); } catch (e) { }
    };

    /* ─── chart previews (plain canvas, no Fabric) ─── */
    window.sqHash = function (str) {
        var h = 5381;
        for (var i = 0; i < str.length; i++) { h = ((h << 5) + h + str.charCodeAt(i)) | 0; }
        return h;
    };

    window.sqAlpha = function (c, a) {
        return /^#[0-9a-f]{6}$/i.test(c || '') ? c + a : c;
    };

    window.sqBuildPrims = function (shapes, cats) {
        var prims = [];
        var catColor = function (id) {
            var c = cats.find(function (x) { return x.id === id; });
            return c && c.color ? c.color : '#c9694b';
        };

        shapes.forEach(function (s) {
            var c = catColor(s.cat);
            var rot = s.rot || 0;
            var rad = rot * Math.PI / 180;

            if (s.type === 'row') {
                var count = s.count || 1;
                var x1 = s.x1 || 0, y1 = s.y1 || 0;
                var x2 = s.x2 != null ? s.x2 : 100, y2 = s.y2 != null ? s.y2 : 0;
                var cx = (x1 + x2) / 2, cy = (y1 + y2) / 2;

                for (var i = 0; i < count; i++) {
                    var t = count > 1 ? i / (count - 1) : 0;
                    var px = x1 + (x2 - x1) * t;
                    var py = y1 + (y2 - y1) * t;

                    if (s.curve) {
                        var dx = x2 - x1, dy = y2 - y1;
                        var len = Math.hypot(dx, dy) || 1;
                        var mx = cx + (-dy / len) * s.curve * 2;
                        var my = cy + (dx / len) * s.curve * 2;
                        var u = 1 - t;
                        px = u * u * x1 + 2 * u * t * mx + t * t * x2;
                        py = u * u * y1 + 2 * u * t * my + t * t * y2;
                    }
                    if (rot) {
                        var rx = px - cx, ry = py - cy;
                        px = cx + rx * Math.cos(rad) - ry * Math.sin(rad);
                        py = cy + rx * Math.sin(rad) + ry * Math.cos(rad);
                    }
                    prims.push({ k: 'circle', x: px, y: py, r: 7, fill: c, stroke: '#ffffff', sw: 1.2 });
                }
            }
            else if (s.type === 'table') {
                var radius = s.r || 30;
                prims.push({ k: 'circle', x: s.x, y: s.y, r: radius, fill: window.sqAlpha(c, '44'), stroke: c, sw: 1.5 });
                var tCount = s.count || 6;
                for (var k = 0; k < tCount; k++) {
                    var a = k / tCount * Math.PI * 2;
                    prims.push({
                        k: 'circle',
                        x: s.x + Math.cos(a) * (radius + 12),
                        y: s.y + Math.sin(a) * (radius + 12),
                        r: 6, fill: c, stroke: '#ffffff', sw: 1
                    });
                }
            }
            else if (s.type === 'rect' || s.type === 'general') {
                var isRect = s.type === 'rect';
                var fill = isRect ? '#e6e9f4' : window.sqAlpha(c, '33');
                var stroke = isRect ? '#b9c1da' : c;
                var w = s.w || 0, h = s.h || 0;

                if (s.shape === 'circle') {
                    prims.push({ k: 'ell', x: s.x + w / 2, y: s.y + h / 2, rx: w / 2, ry: h / 2, rot: rad, fill: fill, stroke: stroke, sw: 1.5 });
                } else {
                    var corners = [[0, 0], [w, 0], [w, h], [0, h]].map(function (p) {
                        return [
                            s.x + p[0] * Math.cos(rad) - p[1] * Math.sin(rad),
                            s.y + p[0] * Math.sin(rad) + p[1] * Math.cos(rad)
                        ];
                    });
                    prims.push({ k: 'poly', pts: corners, fill: fill, stroke: stroke, sw: 1.5 });
                }
            }
        });
        return prims;
    };

    window.renderAllPreviews = function () {
        requestAnimationFrame(function () {
            document.querySelectorAll('[data-chart-json]').forEach(function (card) {
                var container = card.querySelector('.chart-preview-container, .sq-recent-thumb');
                if (!container) return;
                var canvas = container.querySelector('canvas');
                var placeholder = container.querySelector('.preview-placeholder, .sq-recent-fallback');
                if (!canvas) return;

                var showPlaceholder = function () {
                    if (placeholder) placeholder.style.display = placeholder.classList.contains('sq-recent-fallback') ? 'block' : 'flex';
                    canvas.style.display = 'none';
                    canvas.dataset.sig = '';
                };

                var json = card.getAttribute('data-chart-json');
                if (!json || json === 'null' || json === 'undefined') { showPlaceholder(); return; }

                var box = container.getBoundingClientRect();
                var w = Math.round(box.width), h = Math.round(box.height);
                if (w < 2 || h < 2) return;

                var pill = container.querySelector('.sq-stage-pill');
                var hasPill = !!pill && getComputedStyle(pill).display !== 'none';
                var sig = w + 'x' + h + ':' + (hasPill ? 'p' : 'n') + ':' + json.length + ':' + window.sqHash(json);
                if (canvas.dataset.sig === sig) return;   // already drawn at this size

                try {
                    var data = JSON.parse(json);
                    var shapes = data.shapes || data.objects || [];
                    var cats = data.cats || [];
                    if (!shapes.length) throw new Error('Empty chart');

                    var prims = window.sqBuildPrims(shapes, cats);
                    if (!prims.length) throw new Error('Nothing to draw');

                    var minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
                    var grow = function (x0, y0, x1, y1) {
                        if (x0 < minX) minX = x0;
                        if (y0 < minY) minY = y0;
                        if (x1 > maxX) maxX = x1;
                        if (y1 > maxY) maxY = y1;
                    };
                    prims.forEach(function (p) {
                        var m = (p.sw || 0) / 2;
                        if (p.k === 'circle') {
                            grow(p.x - p.r - m, p.y - p.r - m, p.x + p.r + m, p.y + p.r + m);
                        } else if (p.k === 'ell') {
                            var hx = Math.sqrt(Math.pow(p.rx * Math.cos(p.rot), 2) + Math.pow(p.ry * Math.sin(p.rot), 2));
                            var hy = Math.sqrt(Math.pow(p.rx * Math.sin(p.rot), 2) + Math.pow(p.ry * Math.cos(p.rot), 2));
                            grow(p.x - hx - m, p.y - hy - m, p.x + hx + m, p.y + hy + m);
                        } else {
                            p.pts.forEach(function (pt) { grow(pt[0] - m, pt[1] - m, pt[0] + m, pt[1] + m); });
                        }
                    });

                    var dpr = window.devicePixelRatio || 1;
                    canvas.width = Math.round(w * dpr);
                    canvas.height = Math.round(h * dpr);
                    var ctx = canvas.getContext('2d');
                    ctx.setTransform(1, 0, 0, 1, 0, 0);
                    ctx.clearRect(0, 0, canvas.width, canvas.height);

                    var pad = Math.min(w, h) * 0.12;
                    var topPad = hasPill ? h * 0.2 : pad;
                    var bw = Math.max(maxX - minX, 1), bh = Math.max(maxY - minY, 1);
                    var scale = Math.min((w - pad * 2) / bw, (h - topPad - pad) / bh);
                    var ox = (w - bw * scale) / 2 - minX * scale;
                    var oy = topPad + (h - topPad - pad - bh * scale) / 2 - minY * scale;
                    ctx.setTransform(dpr * scale, 0, 0, dpr * scale, dpr * ox, dpr * oy);

                    prims.forEach(function (p) {
                        ctx.beginPath();
                        if (p.k === 'circle') {
                            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                        } else if (p.k === 'ell') {
                            ctx.ellipse(p.x, p.y, p.rx, p.ry, p.rot, 0, Math.PI * 2);
                        } else {
                            p.pts.forEach(function (pt, i) { i ? ctx.lineTo(pt[0], pt[1]) : ctx.moveTo(pt[0], pt[1]); });
                            ctx.closePath();
                        }
                        ctx.fillStyle = p.fill;
                        ctx.fill();
                        ctx.lineWidth = p.sw;
                        ctx.strokeStyle = p.stroke;
                        ctx.stroke();
                    });

                    canvas.style.display = 'block';
                    if (placeholder) placeholder.style.display = 'none';
                    canvas.dataset.sig = sig;
                } catch (e) {
                    console.warn('Preview error for chart:', card.getAttribute('data-chart-id'), e);
                    showPlaceholder();
                }
            });
        });
    };

    // redraw crisply when the window (and so the card size) changes
    if (!window.__sqPreviewResize) {
        window.__sqPreviewResize = true;
        var __sqT;
        window.addEventListener('resize', function () {
            clearTimeout(__sqT);
            __sqT = setTimeout(window.renderAllPreviews, 150);
        });
    }
</script>
