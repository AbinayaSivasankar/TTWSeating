<script>
    // ─── DROPDOWN CLICK OUTSIDE ───
    window.registerDropdownClickHandler = function(dotNetRef) {
        document.addEventListener('click', function(event) {
            var dropdown = document.querySelector('.avatar-wrapper');
            if (dropdown && !dropdown.contains(event.target)) {
                dotNetRef.invokeMethodAsync('CloseDropdown');
            }
        });
    };
        window.renderAllPreviews = function() {
        var cards = document.querySelectorAll('.terracotta-row-card');
        cards.forEach(function(card) {
            var container = card.querySelector('.chart-preview-container');
            var canvasEl = container?.querySelector('canvas');
            var placeholder = container?.querySelector('.preview-placeholder');
            var jsonData = card.getAttribute('data-chart-json');

            // If no JSON, show placeholder
            if (!jsonData || jsonData === '' || jsonData === 'null' || jsonData === 'undefined') {
                if (placeholder) {
                    placeholder.style.display = 'flex';
                    placeholder.innerHTML = '<i class="fa-solid fa-image" style="font-size:18px;color:#a48d7a;"></i>';
                }
                if (canvasEl) canvasEl.style.display = 'none';
                return;
            }

            try {
                var json = JSON.parse(jsonData);
                if (!json.objects || json.objects.length === 0) {
                    throw new Error('Empty chart');
                }

                // Prepare the canvas (64x64)
                canvasEl.width = 64;
                canvasEl.height = 64;
                canvasEl.style.display = 'block';
                if (placeholder) {
                    placeholder.style.display = 'none';
                    placeholder.innerHTML = '';
                }

                // Create a Fabric canvas for preview
                var fabricCanvas = new fabric.Canvas(canvasEl, {
                    renderOnAddRemove: false,
                    selection: false,
                    hoverCursor: 'default',
                    enableRetinaScaling: false,
                    width: 64,
                    height: 64
                });

                // ---- Recreate objects manually (like in loadLayout) ----
                // We copy the logic from your class methods.
                // Make sure these functions are accessible globally, or inline them here.

                json.objects.forEach(function(objData) {
                    // Handle shapes (general rectangles, rectangles)
                    if (objData.objectType === 'genrectangle') {
                        // You need to implement recreateGeneralRectangleFromData for preview.
                        // It should add a rectangle to fabricCanvas using objData.
                        recreateGeneralRectangleForPreview(fabricCanvas, objData);
                    }
                    else if (objData.objectType === 'rectangle') {
                        recreateRectangleForPreview(fabricCanvas, objData);
                    }
                    else if (objData.type === "group" && objData.seatId) {
                        recreateSeatForPreview(fabricCanvas, objData);
                    }
                });

                // Handle text labels (row labels and rectangle labels)
                json.objects.forEach(function(objData) {
                    if (objData.type === "text" || objData.type === "i-text") {
                        if (objData.isRowLabel === true) {
                            recreateRowLabelForPreview(fabricCanvas, objData);
                        }
                        else if (objData.isRectangleLabel === true || objData.generalLabel) {
                            recreateRectangleLabelForPreview(fabricCanvas, objData);
                        }
                    }
                });

                // ---- Fit and center the chart inside 64x64 ----
                // Reuse your fitAndCenterChart logic (or a scaled-down version)
                fitAndCenterPreview(fabricCanvas, 64, 64);

                // Render and clean up
                fabricCanvas.renderAll();
                // We keep the canvas alive for the preview, so do NOT dispose here.

            } catch (e) {
                console.warn('Preview error for chart:', card.getAttribute('data-chart-id'), e);
                if (placeholder) {
                    placeholder.style.display = 'flex';
                    placeholder.innerHTML = '<i class="fa-solid fa-image" style="font-size:18px;color:#a48d7a;"></i>';
                }
                if (canvasEl) canvasEl.style.display = 'none';
            }
        });
    };

    // ---- Helper functions for preview (copy from your class and adapt) ----

    function recreateGeneralRectangleForPreview(canvas, objData) {
        // Similar to your recreateGeneralRectangleFromData but simplified for preview
        const rect = new fabric.Rect({
            left: objData.left || 0,
            top: objData.top || 0,
            width: objData.width || 40,
            height: objData.height || 40,
            fill: objData.fill || '#cccccc',
            stroke: objData.stroke || '#000000',
            strokeWidth: objData.strokeWidth || 1,
            originX: objData.originX || 'left',
            originY: objData.originY || 'top',
            selectable: false,
            evented: false
        });
        canvas.add(rect);
    }

    function recreateRectangleForPreview(canvas, objData) {
        // Same as above, adjust properties as needed
        const rect = new fabric.Rect({
            left: objData.left || 0,
            top: objData.top || 0,
            width: objData.width || 40,
            height: objData.height || 40,
            fill: objData.fill || '#cccccc',
            stroke: objData.stroke || '#000000',
            strokeWidth: objData.strokeWidth || 1,
            originX: objData.originX || 'left',
            originY: objData.originY || 'top',
            selectable: false,
            evented: false
        });
        canvas.add(rect);
    }

    function recreateSeatForPreview(canvas, objData) {
        const radius = 8; // adjust for preview (maybe smaller)
        const circle = new fabric.Circle({
            radius: radius,
            fill: objData.categoryId || 'white',
            stroke: objData.categoryId || 'black',
            strokeWidth: objData.strokeWidth || 1,
            originX: 'center',
            originY: 'center',
            selectable: false,
            evented: false
        });
        const text = new fabric.Text(objData.seatLabel || '', {
            fontSize: 6, // smaller for preview
            fontWeight: 'bold',
            fill: 'white',
            originX: 'center',
            originY: 'center',
            selectable: false,
            evented: false
        });
        const seatGroup = new fabric.Group([circle, text], {
            left: objData.left || 0,
            top: objData.top || 0,
            originX: 'center',
            originY: 'center',
            selectable: false,
            evented: false
        });
        canvas.add(seatGroup);
    }

    function recreateRowLabelForPreview(canvas, objData) {
        const text = new fabric.Text(objData.text || objData.rowLabel || '', {
            left: objData.left || 0,
            top: objData.top || 0,
            fontSize: Math.min(objData.fontSize || 10, 12),
            fontWeight: objData.fontWeight || 'normal',
            fill: objData.fill || 'black',
            originX: objData.originX || 'center',
            originY: objData.originY || 'center',
            selectable: false,
            evented: false
        });
        canvas.add(text);
    }

    function recreateRectangleLabelForPreview(canvas, objData) {
        const text = new fabric.Text(objData.text || '', {
            left: objData.left || 0,
            top: objData.top || 0,
            fontSize: Math.min(objData.fontSize || 10, 12),
            fontWeight: objData.fontWeight || 'normal',
            fill: objData.fill || 'black',
            originX: objData.originX || 'center',
            originY: objData.originY || 'center',
            selectable: false,
            evented: false
        });
        canvas.add(text);
    }

    function fitAndCenterPreview(canvas, targetWidth, targetHeight) {
        // Calculate bounding box of all objects
        var objects = canvas.getObjects();
        if (objects.length === 0) return;

        var rect = canvas.getObjects().reduce(function(acc, obj) {
            var bounds = obj.getBoundingRect();
            if (!acc) return bounds;
            return {
                left: Math.min(acc.left, bounds.left),
                top: Math.min(acc.top, bounds.top),
                width: Math.max(acc.left + acc.width, bounds.left + bounds.width) - Math.min(acc.left, bounds.left),
                height: Math.max(acc.top + acc.height, bounds.top + bounds.height) - Math.min(acc.top, bounds.top)
            };
        }, null);

        if (!rect || rect.width === 0 || rect.height === 0) return;

        // Compute scale to fit inside target with some margin
        var scaleX = (targetWidth * 0.9) / rect.width;
        var scaleY = (targetHeight * 0.9) / rect.height;
        var scale = Math.min(scaleX, scaleY, 1); // don't enlarge too much if already small

        // Center the group
        var centerX = targetWidth / 2;
        var centerY = targetHeight / 2;
        var groupCenterX = rect.left + rect.width / 2;
        var groupCenterY = rect.top + rect.height / 2;

        canvas.forEachObject(function(obj) {
            obj.left = (obj.left - groupCenterX) * scale + centerX;
            obj.top = (obj.top - groupCenterY) * scale + centerY;
            obj.scaleX = (obj.scaleX || 1) * scale;
            obj.scaleY = (obj.scaleY || 1) * scale;
            obj.setCoords();
        });
    }
   
   
</script>

