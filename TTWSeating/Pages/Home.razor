@page "/home"
@using DataLayer;
@using System.Collections.Specialized
@using System.Data
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />

<style>
    :root {
        --color-text-primary: var(--color-text);
        --color-text-secondary: var(--color-text-muted);
        --color-surface-hover: var(--color-primary-soft);
        --bg-body: var(--color-bg);
        --bg-surface: var(--color-surface);
        --bg-card: var(--color-surface);
        --bg-elevated: var(--color-bg);
        --bg-hover: var(--color-primary-soft);
        --bg-active: var(--color-primary-soft);
        --border-subtle: var(--color-border);
        --border-medium: var(--color-border);
        --border-strong: var(--color-text-muted);
        --text-primary: var(--color-text);
        --text-secondary: var(--color-text-muted);
        --text-muted: var(--color-text-muted);
        --text-inverse: var(--color-on-primary);
        --accent-1: var(--color-primary);
        --accent-1-dark: var(--color-primary-hover);
        --accent-1-light: var(--color-primary-soft);
        --accent-1-glow: color-mix(in srgb, var(--color-primary) 20%, transparent);
        --accent-2: var(--color-primary-hover);
        --accent-success: var(--color-success);
        --accent-danger: var(--color-danger);
        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 16px;
        --radius-xl: 20px;
        --radius-full: 9999px;
        --shadow-card: 0 1px 2px rgba(11, 27, 58, 0.06), 0 4px 12px rgba(11, 27, 58, 0.05);
        --shadow-elevated: 0 8px 32px rgba(15, 23, 42, 0.12);
        --shadow-glow: 0 0 30px color-mix(in srgb, var(--color-primary) 12%, transparent);
        --font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* ─── ANIMATIONS ─── */
    @@keyframes fadeSlideIn {
        0% {
            opacity: 0;
            transform: translateY(-10px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeIn {
        0% {
            opacity: 0;
            transform: translateY(-8px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulseGlow {
        0%, 100% {
            box-shadow: 0 0 20px var(--accent-1-glow);
        }

        50% {
            box-shadow: 0 0 40px var(--accent-1-glow), 0 0 60px rgba(201, 105, 75, 0.1);
        }
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-6px);
        }
    }

    /* ─── GLOBAL ─── */
    body {
        background: #F2F2F2;
        color: #111;
        font-family: "Segoe UI", Inter, system-ui, sans-serif;
        animation: fadeSlideIn 0.5s ease;
        margin: 0;
        padding: 0;
    }

    /* ─── LEGACY HEADER ─── */
    .terracotta-header {
        background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
        color: white;
        padding: 8px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 4px 20px var(--accent-1-glow);
        border-bottom: 2px solid rgba(255,255,255,0.15);
        gap: 16px;
        flex-wrap: wrap;
        position: relative;
        z-index: 100;
    }

        .terracotta-header .header-left {
            display: flex;
            align-items: center;
            flex: 0 0 auto;
        }

        .terracotta-header .header-title {
            font-size: 22px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
            white-space: nowrap;
        }

            .terracotta-header .header-title i {
                font-size: 22px;
                background: rgba(255,255,255,0.2);
                padding: 6px;
                border-radius: var(--radius-md);
            }

    .header-tabs {
        display: flex;
        gap: 4px;
        background: rgba(255,255,255,0.12);
        border-radius: var(--radius-lg);
        padding: 4px;
        backdrop-filter: blur(4px);
        justify-content: center;
        max-width: 400px;
        margin: 0 auto;
    }

        .header-tabs .nav-item {
            list-style: none;
        }

        .header-tabs .nav-link {
            color: rgba(255,255,255,0.75);
            border-radius: var(--radius-md);
            padding: 6px 18px;
            font-weight: 500;
            font-size: 14px;
            border: none;
            background: transparent;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            white-space: nowrap;
        }

            .header-tabs .nav-link i {
                font-size: 16px;
            }

            .header-tabs .nav-link:hover {
                background: rgba(255,255,255,0.15);
                color: white;
            }

            .header-tabs .nav-link.active {
                background: white;
                color: var(--accent-1);
                box-shadow: 0 2px 12px rgba(0,0,0,0.15);
                font-weight: 600;
            }

    .terracotta-header .header-right {
        display: flex;
        align-items: center;
        gap: 16px;
        flex: 0 0 auto;
        position: relative;
    }

    /* ─── AVATAR WRAPPER ─── */
    .avatar-wrapper {
        position: relative;
        cursor: pointer;
    }

        .avatar-wrapper .avatar {
            width: 36px;
            height: 36px;
            border-radius: var(--radius-full);
            background: rgba(255,255,255,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 15px;
            border: 2px solid rgba(255,255,255,0.3);
            transition: var(--transition);
            color: white;
            user-select: none;
        }

            .avatar-wrapper .avatar:hover {
                transform: scale(1.1);
                background: rgba(255,255,255,0.3);
            }

        .avatar-wrapper .dropdown-menu {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            min-width: 160px;
            background: var(--bg-surface);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-elevated);
            border: 1px solid var(--border-subtle);
            padding: 6px 0;
            display: none;
            animation: fadeIn 0.2s ease;
            z-index: 1000;
            overflow: hidden;
        }

            .avatar-wrapper .dropdown-menu.show {
                display: block;
            }

            .avatar-wrapper .dropdown-menu .dropdown-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 18px;
                font-size: 13px;
                color: var(--text-primary);
                cursor: pointer;
                transition: var(--transition);
                border: none;
                background: transparent;
                width: 100%;
                text-align: left;
                font-family: var(--font);
                font-weight: 500;
            }

                .avatar-wrapper .dropdown-menu .dropdown-item:hover {
                    background: var(--bg-hover);
                    color: var(--accent-1);
                }

                .avatar-wrapper .dropdown-menu .dropdown-item i {
                    font-size: 15px;
                    width: 18px;
                    color: var(--text-muted);
                    transition: var(--transition);
                }

                .avatar-wrapper .dropdown-menu .dropdown-item:hover i {
                    color: var(--accent-1);
                }

                .avatar-wrapper .dropdown-menu .dropdown-item.danger {
                    color: var(--accent-danger);
                }

                    .avatar-wrapper .dropdown-menu .dropdown-item.danger:hover {
                        background: rgba(192, 90, 74, 0.08);
                    }

                    .avatar-wrapper .dropdown-menu .dropdown-item.danger i {
                        color: var(--accent-danger);
                    }

            .avatar-wrapper .dropdown-menu .dropdown-divider {
                height: 1px;
                background: var(--border-subtle);
                margin: 4px 12px;
            }

            .avatar-wrapper .dropdown-menu .dropdown-user-info {
                padding: 8px 18px 4px;
                font-size: 12px;
                color: var(--text-muted);
                border-bottom: 1px solid var(--border-subtle);
                margin-bottom: 4px;
            }

                .avatar-wrapper .dropdown-menu .dropdown-user-info .user-email {
                    font-weight: 500;
                    color: var(--text-primary);
                    font-size: 13px;
                }

    /* ─── LEGACY DASHBOARD / ACTION BAR ─── */
    .terracotta-dashboard {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 20px 30px;
        animation: fadeSlideIn 0.6s ease;
    }

    .terracotta-action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
        background: var(--bg-surface);
        padding: 14px 20px;
        border-radius: var(--radius-lg);
        border: 1px solid var(--border-subtle);
        box-shadow: var(--shadow-card);
    }

        .terracotta-action-bar .search-wrap {
            flex: 1;
            min-width: 200px;
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--bg-body);
            border-radius: var(--radius-md);
            padding: 0 12px;
            border: 1px solid var(--border-subtle);
            transition: var(--transition);
        }

            .terracotta-action-bar .search-wrap:focus-within {
                border-color: var(--accent-1);
                box-shadow: 0 0 0 3px var(--accent-1-glow);
            }

            .terracotta-action-bar .search-wrap i {
                color: var(--text-muted);
                font-size: 14px;
            }

            .terracotta-action-bar .search-wrap input {
                border: none;
                background: transparent;
                padding: 10px 0;
                width: 100%;
                font-size: 13px;
                outline: none;
                color: var(--text-primary);
            }

                .terracotta-action-bar .search-wrap input::placeholder {
                    color: var(--text-muted);
                }

        .terracotta-action-bar .create-btn {
            background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
            color: white;
            border: none;
            border-radius: var(--radius-md);
            padding: 10px 24px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 4px 16px var(--accent-1-glow);
            display: flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

            .terracotta-action-bar .create-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 28px var(--accent-1-glow);
            }

            .terracotta-action-bar .create-btn i {
                font-size: 16px;
            }

    .terracotta-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-bottom: 30px;
    }

    /* ─── BASE CHART CARD (still used via .terracotta-row-card) ─── */
    .terracotta-row-card {
        background: var(--bg-surface);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border-subtle);
        box-shadow: var(--shadow-card);
        padding: 16px 20px;
        cursor: pointer;
        transition: var(--transition);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        position: relative;
        animation: fadeSlideIn 0.4s ease;
        overflow: hidden;
    }

        .terracotta-row-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--accent-1), var(--accent-2));
            opacity: 0;
            transition: var(--transition);
        }

        .terracotta-row-card:hover::before,
        .terracotta-row-card.active::before {
            opacity: 1;
        }

        .terracotta-row-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-elevated);
            border-color: var(--accent-1);
        }

        .terracotta-row-card.active {
            border-color: var(--accent-1);
            background: var(--bg-active);
            box-shadow: 0 0 0 2px var(--accent-1-glow);
        }

        .terracotta-row-card .card-left {
            display: flex;
            align-items: center;
            gap: 16px;
            min-width: 0;
            flex: 1;
        }

        .terracotta-row-card .chart-preview-container {
            width: 64px;
            height: 64px;
            flex-shrink: 0;
            border-radius: var(--radius-md);
            overflow: hidden;
            background: var(--bg-body);
            border: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .terracotta-row-card:hover .chart-preview-container {
            border-color: var(--accent-1);
            box-shadow: 0 0 0 2px var(--accent-1-glow);
        }

        .terracotta-row-card .chart-preview-container canvas {
            width: 100%;
            height: 100%;
            display: block;
            image-rendering: pixelated;
        }

        .terracotta-row-card .chart-preview-container .preview-placeholder {
            font-size: 20px;
            color: #3c3834;
            opacity: 0.3;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .terracotta-row-card .card-info {
            min-width: 0;
            flex: 1;
        }

        .terracotta-row-card .card-title {
            font-weight: 600;
            font-size: 17px;
            color: var(--text-primary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .terracotta-row-card .card-key {
            font-size: 13px;
            color: var(--text-muted);
            font-family: monospace;
            margin-top: 2px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .terracotta-row-card .card-key .copy-btn {
                background: transparent;
                border: none;
                color: var(--text-muted);
                cursor: pointer;
                font-size: 14px;
                padding: 0 4px;
                transition: var(--transition);
            }

                .terracotta-row-card .card-key .copy-btn:hover {
                    color: var(--accent-1);
                }

                .terracotta-row-card .card-key .copy-btn.copied {
                    color: var(--accent-success);
                }

        .terracotta-row-card .card-right {
            display: flex;
            align-items: center;
            gap: 20px;
            flex-shrink: 0;
        }

        .terracotta-row-card .card-meta {
            display: flex;
            align-items: center;
            gap: 16px;
            font-size: 13px;
            color: var(--text-muted);
        }

            .terracotta-row-card .card-meta span {
                display: flex;
                align-items: center;
                gap: 4px;
            }

            .terracotta-row-card .card-meta i {
                font-size: 14px;
            }

        .terracotta-row-card .status-dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--accent-success);
            margin-right: 4px;
            animation: pulseGlow 2s infinite;
        }

        .terracotta-row-card .card-action {
            opacity: 0;
            color: var(--text-muted);
            transition: var(--transition);
            cursor: pointer;
            padding: 6px 10px;
            border-radius: var(--radius-sm);
            font-size: 16px;
            margin-left: 4px;
        }

            .terracotta-row-card .card-action:hover {
                background: var(--accent-1-glow);
                color: var(--accent-1);
            }

        .terracotta-row-card:hover .card-action {
            opacity: 1;
        }

    /* ─── LEGACY DETAILS PANEL ─── */
    .terracotta-details-panel {
        background: var(--bg-surface);
        border-radius: var(--radius-xl);
        padding: 24px 28px;
        border: 1px solid var(--border-subtle);
        box-shadow: var(--shadow-card);
        margin-top: 10px;
        animation: fadeSlideIn 0.4s ease;
        transition: var(--transition);
    }

        .terracotta-details-panel .details-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

            .terracotta-details-panel .details-top h3 {
                font-weight: 700;
                color: var(--text-primary);
                margin: 0;
            }

        .terracotta-details-panel .status-badge {
            padding: 4px 14px;
            border-radius: var(--radius-full);
            font-size: 12px;
            font-weight: 600;
            background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
            color: white;
            box-shadow: 0 2px 12px var(--accent-1-glow);
            animation: pulseGlow 3s infinite;
        }

        .terracotta-details-panel .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px;
            margin-top: 20px;
        }

        .terracotta-details-panel .stat-item {
            background: var(--bg-body);
            padding: 14px 18px;
            border-radius: var(--radius-md);
            border: 1px solid var(--border-subtle);
            transition: var(--transition);
        }

            .terracotta-details-panel .stat-item:hover {
                border-color: var(--accent-1);
                transform: translateY(-2px);
                box-shadow: var(--shadow-glow);
            }

            .terracotta-details-panel .stat-item h4 {
                font-size: 13px;
                color: var(--text-muted);
                font-weight: 500;
                margin-bottom: 4px;
            }

            .terracotta-details-panel .stat-item span {
                font-size: 16px;
                font-weight: 600;
                color: var(--text-primary);
            }

    .terracotta-empty-state {
        text-align: center;
        padding: 60px 20px;
        background: var(--bg-surface);
        border-radius: var(--radius-xl);
        border: 1px solid var(--border-subtle);
        box-shadow: var(--shadow-card);
        animation: float 4s ease-in-out infinite;
    }

        .terracotta-empty-state i {
            background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .terracotta-empty-state h4 {
            font-weight: 700;
            color: var(--text-primary);
        }

        .terracotta-empty-state p {
            color: var(--text-muted);
        }

    .terracotta-settings {
        max-width: 800px;
        margin: 20px auto;
        padding: 30px 40px;
        background: var(--bg-surface);
        border-radius: var(--radius-xl);
        border: 1px solid var(--border-subtle);
        box-shadow: var(--shadow-card);
        animation: fadeSlideIn 0.5s ease;
    }

        .terracotta-settings h3 {
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .terracotta-settings h3 i {
                color: var(--accent-1);
            }

        .terracotta-settings .key-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid var(--border-subtle);
            flex-wrap: wrap;
            gap: 8px;
        }

            .terracotta-settings .key-row:last-child {
                border-bottom: none;
            }

        .terracotta-settings .key-label {
            font-weight: 600;
            color: var(--text-secondary);
            font-size: 14px;
            min-width: 140px;
        }

        .terracotta-settings .key-value {
            font-family: monospace;
            font-size: 14px;
            color: var(--text-primary);
            background: var(--bg-body);
            padding: 4px 12px;
            border-radius: var(--radius-sm);
            flex: 1;
            margin: 0 12px;
            word-break: break-all;
            min-width: 120px;
        }

        .terracotta-settings .copy-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 18px;
            transition: var(--transition);
            padding: 4px 8px;
            border-radius: var(--radius-sm);
        }

            .terracotta-settings .copy-btn:hover {
                background: var(--bg-hover);
                color: var(--accent-1);
            }

            .terracotta-settings .copy-btn.copied {
                color: var(--accent-success);
            }

    .terracotta-row-card .preview-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        padding: 4px 10px;
        border-radius: var(--radius-sm);
        transition: var(--transition);
        border: 1px solid transparent;
    }

        .terracotta-row-card .preview-link:hover {
            color: var(--accent-1);
            background: var(--accent-1-glow);
            border-color: var(--accent-1-glow);
        }

        .terracotta-row-card .preview-link i {
            font-size: 14px;
        }

    @@media (max-width: 768px) {
        .terracotta-header {
            padding: 8px 12px;
            flex-direction: column;
            align-items: stretch;
            gap: 8px;
        }

            .terracotta-header .header-left {
                justify-content: center;
            }

        .header-tabs {
            max-width: 100%;
            width: 100%;
            justify-content: center;
        }

        .terracotta-header .header-right {
            justify-content: center;
        }

        .terracotta-dashboard {
            padding: 0 12px 20px;
        }

        .terracotta-action-bar {
            flex-direction: column;
            align-items: stretch;
        }

            .terracotta-action-bar .search-wrap {
                width: 100%;
            }

            .terracotta-action-bar .create-btn {
                justify-content: center;
            }

        .terracotta-row-card {
            flex-wrap: wrap;
            padding: 14px 16px;
        }

            .terracotta-row-card .card-left {
                width: 100%;
            }

            .terracotta-row-card .card-right {
                width: 100%;
                justify-content: space-between;
                margin-top: 8px;
                flex-wrap: wrap;
                gap: 8px;
            }

            .terracotta-row-card .card-meta {
                flex-wrap: wrap;
                gap: 10px;
            }

            .terracotta-row-card .chart-preview-container {
                width: 48px;
                height: 48px;
            }

        .terracotta-details-panel {
            padding: 16px;
        }

            .terracotta-details-panel .stats-grid {
                grid-template-columns: 1fr;
            }

        .terracotta-settings {
            padding: 20px;
            margin: 12px;
        }

            .terracotta-settings .key-row {
                flex-direction: column;
                align-items: stretch;
            }

            .terracotta-settings .key-value {
                margin: 4px 0;
            }

        .avatar-wrapper .dropdown-menu {
            right: -10px;
            min-width: 140px;
        }
    }

    /* ═════════ SEATSQ PAGE (sq-*) ═════════ */
    body {
        background: #F2F2F2;
        color: #111;
        font-family: 'Instrument Sans', system-ui, sans-serif;
    }

