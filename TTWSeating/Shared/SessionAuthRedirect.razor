@inject SessionAuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation

<AuthCheckLoader Message="@(AuthenticationState.IsInitialized ? "Redirecting to sign in..." : "Checking your sign-in...")" />

@code {
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized)
        {
            return;
        }

        _initialized = true;
        await AuthenticationState.InitializeAsync();
        if (!AuthenticationState.IsAuthenticated)
        {
            Navigation.NavigateTo(Navigation.BaseUri, replace: true);
        }
    }
}
