<style>
    .auth-check-screen {
        display: flex;
        min-height: 100vh;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: #f7f8fc;
        color: #27324a;
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .auth-check-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        color: #5e6880;
        font-size: 14px;
        font-weight: 500;
    }

    .auth-check-spinner {
        width: 36px;
        height: 36px;
        border: 3px solid #e1e5ef;
        border-top-color: #6558d9;
        border-radius: 50%;
        animation: auth-check-spin 0.8s linear infinite;
    }

    @@keyframes auth-check-spin {
        to { transform: rotate(360deg); }
    }

    @@media (prefers-reduced-motion: reduce) {
        .auth-check-spinner { animation-duration: 2s; }
    }
</style>

<div class="auth-check-screen" role="status" aria-live="polite">
    <div class="auth-check-content">
        <span class="auth-check-spinner" aria-hidden="true"></span>
        <span>@Message</span>
    </div>
</div>

@code {
    [Parameter]
    public string Message { get; set; } = "Checking your sign-in...";
}
