@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
<style>
    .app-header {
        background: linear-gradient(to right, #4f46e5, #7c3aed);
        color: white;
        padding: 16px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        overflow: visible;
    }

    .header-title {
        font-size: 22px;
        font-weight: 600;
    }

    .dropdown {
        position: relative;
    }

        /* Profile Image */
        .dropdown img {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid rgba(255,255,255,0.7);
            transition: all 0.3s ease;
        }

            .dropdown img:hover {
                transform: scale(1.05);
                border-color: white;
            }

    /* Dropdown Menu */
    .dropdown-menu {
        position: absolute;
        top: 58px;
        right: 0;
        min-width: 180px;
        background: #ffffff;
        border: none;
        border-radius: 14px;
        padding: 8px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        animation: dropdownFade 0.2s ease;
        overflow: hidden;
    }

    /* Dropdown Items */
    .dropdown-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 500;
        color: #374151;
        transition: all 0.2s ease;
    }

        /* Hover Effect */
        .dropdown-item:hover {
            background: linear-gradient(to right, #6366f1, #7c3aed);
            color: white;
        }

        /* Optional Icon */
        .dropdown-item i {
            font-size: 16px;
        }

    /* Animation */
    @@keyframes dropdownFade {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .profile-img {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        cursor: pointer;
    }

    .dropdown-menu {
        display: block;
    }

    .profile-circle {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: white;
        color: #6d28d9;
        font-size: 20px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: 2px solid rgba(255,255,255,0.7);
        transition: all 0.3s ease;
        text-transform: uppercase;
    }

        .profile-circle:hover {
            transform: scale(1.05);
            border-color: white;
        }
</style>

<header class="app-header d-flex justify-content-between justify-items-center px-3">
    <div class="header-title">HighQ Seats</div>
    <div class="dropdown">

        <div class="profile-circle" @onclick="ToggleMenu">
            @UserInitial
        </div>

        @if (showMenu)
        {
            <ul class="dropdown-menu show dropdown-menu-end">
                <li>
                    <a class="dropdown-item" @onclick="Logout">
                        <i class="bi bi-box-arrow-right"></i>
                        Logout
                    </a>
                </li>
            </ul>
        }
    </div>
</header>

@code {
    [Inject]
    NavigationManager NavManager { get; set; }
    [Inject]
    ProtectedSessionStorage sessionStorage { get; set; }
    string UserEmail = "";

    string UserInitial =>!string.IsNullOrWhiteSpace(UserEmail)? UserEmail.Substring(0, 1).ToUpper(): "?";

    protected override async Task OnInitializedAsync()
    {
        var result = await sessionStorage.GetAsync<string>("UserEmail");

        if (result.Success)
        {
            UserEmail = result.Value;
        }
    }
    private async Task Logout()
    {
        await sessionStorage.SetAsync("UserId", "0");
        await sessionStorage.SetAsync("UserEmail", "");
        NavManager.NavigateTo("/");
    }

    bool showMenu = false;

    void ToggleMenu()
    {
        showMenu = !showMenu;
    }
}