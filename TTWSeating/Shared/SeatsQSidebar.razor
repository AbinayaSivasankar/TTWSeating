<aside class="sq-side">
    <div class="sq-brand">
        <img class="sq-brand-logo" src="images/seatsq-logo.png" alt="SeatsQ" />
    </div>
    <nav class="sq-nav" aria-label="Main">
        <button type="button" class="sq-nav-item @(ActiveView == "charts" ? "active" : "")" @onclick='() => ViewChanged.InvokeAsync("charts")'>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="2"></rect><rect x="14" y="3" width="7" height="7" rx="2"></rect><rect x="3" y="14" width="7" height="7" rx="2"></rect><rect x="14" y="14" width="7" height="7" rx="2"></rect></svg>
            Charts
        </button>
        <button type="button" class="sq-nav-item @(ActiveView == "settings" ? "active" : "")" @onclick='() => ViewChanged.InvokeAsync("settings")'>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.7 1.7-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5v.2h-2.4v-.2a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1L8 17l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H6.7v-2.4h.2a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.9L8 8.6l1.7-1.7.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.5v-.2h2.4v.2a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.7 1.7-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.5 1h.2V14h-.2a1.7 1.7 0 0 0-1.5 1z"></path></svg>
            Settings
        </button>
    </nav>
    <div class="sq-side-user">
        <span class="sq-avatar sq-sidebar-avatar" aria-hidden="true">@UserInitial</span>
        <span>@UserEmail</span>
    </div>
</aside>

@code {
    [Parameter]
    public string ActiveView { get; set; } = "charts";

    [Parameter]
    public string UserEmail { get; set; } = "";

    [Parameter]
    public EventCallback<string> ViewChanged { get; set; }

    private string UserInitial => !string.IsNullOrWhiteSpace(UserEmail)
        ? UserEmail[..1].ToUpperInvariant()
        : "?";
}
